#!/bin/sh
# bootstrap — развернуть обвязку на новой машине одной командой.
#
# Что делает по порядку:
#   1. проверяет, что есть чем работать (Node, git);
#   2. показывает, какие инструменты найдены;
#   3. спрашивает подтверждение — обвязка расширяет полномочия агента,
#      поэтому ставится осознанно, а не «молча при первом запуске»;
#   4. разворачивает и проверяет результат.
#
# Ничего не удаляет и не перезаписывает: только создаёт свои ссылки.

set -eu

HERE=$(cd "$(dirname "$0")" && pwd)
REPO=$(dirname "$HERE")

say()  { printf '%s\n' "$*"; }
fail() { printf 'ошибка: %s\n' "$*" >&2; exit 1; }

say "Обвязка: $REPO"
say ""

# ── 1. Предпосылки ─────────────────────────────────────────────────────────
command -v git >/dev/null 2>&1 || fail "нет git — установите и повторите"
if ! command -v node >/dev/null 2>&1; then
  fail "нет node — установщику нужен Node.
  macOS:  brew install node
  Linux:  см. https://nodejs.org
Затем повторите: $0"
fi

NODE_MAJOR=$(node -e 'console.log(process.versions.node.split(".")[0])')
[ "$NODE_MAJOR" -ge 18 ] || fail "нужен Node 18 или новее, установлен $(node -v)"

say "Node $(node -v) — ок"
say ""

# ── 2. Что найдено ─────────────────────────────────────────────────────────
say "── Что найдено на этой машине ──"
"$HERE/harness" detect
say ""

# ── 3. Подтверждение ───────────────────────────────────────────────────────
if [ "${HARNESS_YES:-}" != "1" ]; then
  printf 'Развернуть обвязку? [y/N] '
  read -r answer </dev/tty || answer="n"
  case "$answer" in
    y|Y|yes|YES) ;;
    *) say "Отменено. Ничего не изменено."; exit 0 ;;
  esac
fi

# ── 4. Установка и проверка ────────────────────────────────────────────────
say ""
say "── Установка ──"
"$HERE/harness" install all

say ""
say "── Точка входа ядра ──"
say "Скиллы инструмент подхватывает сам, а правила поведения — нет."
say "Короткий файл-указатель ставится только туда, где его ещё нет:"
say "существующий файл инструкций не перезаписывается никогда."
say ""
"$HERE/harness" entrypoint --write

say ""
say "── Проверка ──"
if "$HERE/harness" doctor; then
  say ""
  say "Готово. Скиллы подключены ссылками — правка в репозитории видна инструментам сразу."
else
  say ""
  say "Установка завершена, но проверка нашла проблемы (см. выше)."
  say "Ничего не сломано: разобраться помогает $HERE/harness doctor"
  exit 1
fi
