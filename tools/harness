#!/usr/bin/env node
/**
 * harness — установщик и сторож личной обвязки агентов.
 *
 * Замысел: ядро (скиллы, правила, процедуры) живёт в этом репозитории и
 * подключается в инструменты ССЫЛКАМИ, а не копиями. Правка одна — видят все.
 * Что и куда поставлено, записано в ~/.harness/state.json, поэтому prune
 * убирает ровно своё и не трогает чужое.
 *
 * Зависимостей нет: только Node и файловая система. Манифест — ограниченный
 * YAML (см. harness.yaml и ARCHITECTURE.md).
 *
 * Команды: detect · install · outdated · update · prune · doctor · inventory
 */

import fs from 'node:fs'
import path from 'node:path'
import os from 'node:os'
import crypto from 'node:crypto'
import { fileURLToPath } from 'node:url'
import { execFileSync, spawnSync } from 'node:child_process'

const HERE = path.dirname(fileURLToPath(import.meta.url))
const REPO = path.resolve(HERE, '..')
const MANIFEST = path.join(REPO, 'harness.yaml')

// ─── Разбор ограниченного YAML ──────────────────────────────────────────────
// Поддерживается ровно то, что есть в harness.yaml: вложенные словари по
// отступам, списки «- » (скаляры и словари), простые скаляры в кавычках или без.
// Всё остальное — ошибка разбора, а не молчаливое «не понял».

function parseScalar(raw) {
  const v = raw.trim()
  if (v === '') return null
  if (v === '[]') return []
  if (v === 'true') return true
  if (v === 'false') return false
  if (/^-?\d+$/.test(v)) return Number(v)
  if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) return v.slice(1, -1)
  return v
}

function parseYaml(text) {
  const lines = text.split('\n')
  const root = {}
  const stack = [{ indent: -1, node: root, lastKey: null }]

  for (let i = 0; i < lines.length; i++) {
    const raw = lines[i]
    if (/^\s*#/.test(raw) || raw.trim() === '') continue
    const indent = raw.length - raw.replace(/^\s*/, '').length
    const line = raw.trim()

    while (stack.length > 1 && indent <= stack[stack.length - 1].indent) stack.pop()
    const parent = stack[stack.length - 1].node

    if (line.startsWith('- ') || line === '-') {
      if (!Array.isArray(parent)) throw new Error(`строка ${i + 1}: элемент списка там, где ожидался словарь`)
      const rest = line.slice(2).trim()
      if (rest === '') { const obj = {}; parent.push(obj); stack.push({ indent, node: obj, lastKey: null }); continue }
      const m = rest.match(/^([A-Za-z0-9_.-]+):\s*(.*)$/)
      if (m) {
        const obj = {}
        obj[m[1]] = parseScalar(m[2])
        parent.push(obj)
        stack.push({ indent, node: obj, lastKey: null })
      } else {
        parent.push(parseScalar(rest))
      }
      continue
    }

    const m = line.match(/^([A-Za-z0-9_.-]+):\s*(.*)$/)
    if (!m) {
      // Многострочное значение: продолжение строки скаляра с отступом.
      // Это корректный YAML (plain scalar), и реальные парсеры его принимают —
      // поэтому считать такой файл битым нельзя.
      const frame = stack[stack.length - 1]
      const key = frame.lastKey
      if (key && typeof frame.node[key] === 'string' && indent > frame.indent) {
        frame.node[key] += ' ' + line
        continue
      }
      throw new Error(`строка ${i + 1}: не разобрана → ${line.slice(0, 60)}`)
    }
    const [, key, valueRaw] = m
    if (valueRaw.trim() === '') {
      // Смотрим вперёд: список или словарь?
      let j = i + 1
      while (j < lines.length && (lines[j].trim() === '' || /^\s*#/.test(lines[j]))) j++
      const nextIsList = j < lines.length && lines[j].trim().startsWith('- ')
      const node = nextIsList ? [] : {}
      parent[key] = node
      stack.push({ indent, node, lastKey: null })
    } else {
      parent[key] = parseScalar(valueRaw)
      stack[stack.length - 1].lastKey = key
    }
  }
  return root
}

// ─── Утилиты ────────────────────────────────────────────────────────────────
const tilde = (p) => (p && p.startsWith('~') ? path.join(os.homedir(), p.slice(1)) : p)
const C = process.stdout.isTTY
  ? { r: '\x1b[31m', g: '\x1b[32m', y: '\x1b[33m', d: '\x1b[2m', b: '\x1b[1m', x: '\x1b[0m' }
  : { r: '', g: '', y: '', d: '', b: '', x: '' }

function loadManifest() {
  if (!fs.existsSync(MANIFEST)) die(`нет манифеста: ${MANIFEST}`)
  return parseYaml(fs.readFileSync(MANIFEST, 'utf8'))
}

function stateFile(man) { return tilde(man.state_path || '~/.harness/state.json') }

function loadState(man) {
  const f = stateFile(man)
  if (!fs.existsSync(f)) return { version: 1, repo: REPO, tools: {} }
  try { return JSON.parse(fs.readFileSync(f, 'utf8')) } catch { return { version: 1, repo: REPO, tools: {} } }
}

function saveState(man, st) {
  const f = stateFile(man)
  fs.mkdirSync(path.dirname(f), { recursive: true })
  st.repo = REPO
  st.updatedAt = new Date().toISOString()
  fs.writeFileSync(f, JSON.stringify(st, null, 2) + '\n')
}

function die(msg) { console.error(`${C.r}ошибка:${C.x} ${msg}`); process.exit(1) }

function hasCommand(cmd) {
  if (!cmd) return false
  try { execFileSync('sh', ['-c', `command -v ${JSON.stringify(cmd)}`], { stdio: 'ignore' }); return true } catch { return false }
}

function hashDir(dir) {
  const h = crypto.createHash('sha256')
  const walk = (d, rel = '') => {
    for (const e of fs.readdirSync(d, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
      const p = path.join(d, e.name)
      const r = path.join(rel, e.name)
      if (e.isDirectory()) walk(p, r)
      else { h.update(r); h.update(fs.readFileSync(p)) }
    }
  }
  if (fs.existsSync(dir)) walk(dir)
  return h.digest('hex').slice(0, 16)
}

/** Разбор фронтматтера SKILL.md ограниченным YAML. */
function readSkill(dir) {
  const f = path.join(dir, 'SKILL.md')
  if (!fs.existsSync(f)) return { error: 'нет SKILL.md' }
  const text = fs.readFileSync(f, 'utf8')
  const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---/)
  if (!m) return { error: 'нет YAML-фронтматтера' }
  let meta
  try { meta = parseYaml(m[1]) } catch (e) { return { error: `битый YAML: ${e.message}` } }
  if (!meta.name) return { error: 'фронтматтер без name' }
  if (!meta.description) return { error: 'фронтматтер без description' }
  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(meta.name)) return { error: `имя не kebab-case: ${meta.name}` }
  const evidenceFile = path.join(dir, 'EVIDENCE.md')
  const hasEvidence = fs.existsSync(evidenceFile)
  // Наличие файла — ещё не доказательство: заготовка из шаблона помечена
  // маркером и остаётся кандидатом, пока замер не внесён.
  const filled = hasEvidence && !fs.readFileSync(evidenceFile, 'utf8').includes('НЕ ЗАПОЛНЕНО')
  const evidence = hasEvidence
  const status = meta.status || (filled ? 'proven' : 'candidate')
  return { meta, name: meta.name, status, evidence, filled, dir, hash: hashDir(dir) }
}

function coreSkills(man) {
  const root = path.join(REPO, man.core_skills || 'core/skills')
  if (!fs.existsSync(root)) return []
  return fs.readdirSync(root, { withFileTypes: true })
    // Каталоги с «_» в начале — служебные (шаблон), а не скиллы.
    .filter((e) => e.isDirectory() && !e.name.startsWith('.') && !e.name.startsWith('_'))
    .map((e) => readSkill(path.join(root, e.name)))
    .map((s, i, arr) => ({ ...s, dirName: fs.readdirSync(root).filter((n) => !n.startsWith('.'))[i] }))
}

// ─── Команды ────────────────────────────────────────────────────────────────

function cmdDetect(man) {
  console.log(`${C.b}Инструменты на этой машине${C.x}\n`)
  const rows = []
  for (const [id, t] of Object.entries(man.tools || {})) {
    const byCmd = hasCommand(t.detect_cmd)
    const dirs = [].concat(t.detect_dirs || []).map(tilde)
    const byDir = dirs.some((d) => fs.existsSync(d))
    const found = byCmd || byDir
    rows.push({ id, title: t.title, found, how: byCmd ? `команда ${t.detect_cmd}` : byDir ? 'каталог' : '—' })
  }
  rows.sort((a, b) => (a.found === b.found ? 0 : a.found ? -1 : 1))
  for (const r of rows) {
    const mark = r.found ? `${C.g}●${C.x}` : `${C.d}○${C.x}`
    console.log(`${mark} ${r.id.padEnd(18)} ${String(r.title || '').padEnd(24)} ${C.d}${r.how}${C.x}`)
  }
  const n = rows.filter((r) => r.found).length
  console.log(`\nнайдено: ${n} из ${rows.length}`)
}

function targetSkills(t, man, includeCandidates) {
  const skills = coreSkills(man).filter((s) => {
    if (s.error) return false
    if (s.status === 'disabled') return false
    if (s.status === 'candidate' && !includeCandidates) return false
    return true
  })
  return skills
}

function linkSkill(skill, root, layout) {
  const name = skill.name
  const dest = layout === 'nested'
    ? path.join(root, skill.meta.category || 'imported', name)
    : path.join(root, name)
  fs.mkdirSync(path.dirname(dest), { recursive: true })

  if (fs.existsSync(dest) || fs.lstatSync(path.dirname(dest)).isDirectory() && isSymlink(dest)) {
    if (isSymlink(dest)) {
      const cur = fs.readlinkSync(dest)
      if (path.resolve(path.dirname(dest), cur) === skill.dir) return { dest, action: 'ok' }
      fs.unlinkSync(dest)
    } else {
      return { dest, action: 'skip-busy', reason: 'путь занят не нашей ссылкой' }
    }
  }
  fs.symlinkSync(skill.dir, dest)
  return { dest, action: 'linked' }
}

function isSymlink(p) { try { return fs.lstatSync(p).isSymbolicLink() } catch { return false } }

function cmdInstall(man, which, includeCandidates) {
  const skills = coreSkills(man)
  const bad = skills.filter((s) => s.error)
  if (bad.length) {
    console.log(`${C.y}пропущены скиллы с дефектами:${C.x}`)
    for (const b of bad) console.log(`  ${C.r}✗${C.x} ${path.basename(b.dir)} — ${b.error}`)
    console.log('')
  }
  const ready = targetSkills(null, man, includeCandidates)
  console.log(`${C.b}К установке:${C.x} ${ready.length} скиллов (доказанных: ${ready.filter((s) => s.status === 'proven').length}, кандидатов: ${ready.filter((s) => s.status === 'candidate').length})`)
  if (!includeCandidates && ready.some((s) => s.status === 'candidate')) {
    console.log(`${C.d}кандидаты без EVIDENCE.md не ставятся; включить: --candidates${C.x}`)
  }
  console.log('')

  const st = loadState(man)
  const targets = Object.entries(man.tools || {}).filter(([id, t]) => {
    if (which !== 'all' && id !== which) return false
    return hasCommand(t.detect_cmd) || [].concat(t.detect_dirs || []).map(tilde).some((d) => fs.existsSync(d))
  })
  if (!targets.length) die(`не найден ни один инструмент (запрошено: ${which}). Сначала: harness detect`)

  // Общая точка встречи: ставим ядро один раз, если она объявлена.
  // Ссылки записываем под служебной записью «_shared», иначе prune их не увидит.
  const shared = tilde(man.shared_skills_root)
  if (shared) {
    fs.mkdirSync(shared, { recursive: true })
    const rec = (st.tools._shared ||= { skills: [], links: [] })
    let n = 0
    for (const s of ready) {
      const r = linkSkill(s, shared, 'agents')
      rec.links = rec.links.filter((l) => l.dest !== r.dest)
      if (r.action !== 'skip-busy') rec.links.push({ name: s.name, dest: r.dest, target: s.dir, hash: s.hash })
      if (r.action === 'linked') n++
    }
    console.log(`${C.g}✓${C.x} общий каталог ${shared.replace(os.homedir(), '~')} — ссылок создано: ${n}`)
  }

  for (const [id, t] of targets) {
    const rec = (st.tools[id] ||= { skills: [], links: [] })
    console.log(`\n${C.b}${t.title || id}${C.x}`)
    for (const rootSpec of [].concat(t.skill_roots || [])) {
      if (!rootSpec.path) continue
      const root = tilde(rootSpec.path)
      if (root === shared) continue // уже сделано выше
      fs.mkdirSync(root, { recursive: true })
      let linked = 0, skipped = 0
      for (const s of ready) {
        const r = linkSkill(s, root, rootSpec.layout || 'flat')
        if (r.action === 'linked' || r.action === 'ok') linked++
        else { skipped++; console.log(`  ${C.y}!${C.x} ${r.dest.replace(os.homedir(), '~')} — ${r.reason}`) }
        rec.links = rec.links.filter((l) => l.dest !== r.dest)
        if (r.action !== 'skip-busy') rec.links.push({ name: s.name, dest: r.dest, target: s.dir, hash: s.hash })
      }
      console.log(`  ${root.replace(os.homedir(), '~')} (${rootSpec.layout}) — ссылок: ${linked}${skipped ? `, пропущено: ${skipped}` : ''}`)
    }
  }
  saveState(man, st)
  console.log(`\n${C.g}готово.${C.x} Состояние: ${stateFile(man).replace(os.homedir(), '~')}`)
  console.log(`${C.d}проверить: harness doctor${C.x}`)
}

function cmdDoctor(man) {
  let problems = 0, warnings = 0
  console.log(`${C.b}Проверка обвязки${C.x}\n`)

  const skills = coreSkills(man)
  console.log(`${C.b}Скиллы ядра${C.x} (${skills.length})`)
  const names = new Map()
  for (const s of skills) {
    if (s.error) { console.log(`  ${C.r}✗${C.x} ${path.basename(s.dir)} — ${s.error}`); problems++; continue }
    if (names.has(s.name)) { console.log(`  ${C.r}✗${C.x} дубль имени «${s.name}»: ${path.basename(names.get(s.name).dir)} и ${path.basename(s.dir)}`); problems++ }
    else names.set(s.name, s)
    const mark = s.status === 'proven' ? `${C.g}✓${C.x}` : `${C.y}?${C.x}`
    const note = s.status === 'proven' ? 'доказан'
      : s.evidence ? 'кандидат (EVIDENCE.md не заполнен)'
      : 'кандидат (нет EVIDENCE.md)'
    console.log(`  ${mark} ${s.name.padEnd(28)} ${C.d}${note}${C.x}`)
    if (s.status === 'candidate') warnings++
  }

  const reserved = ['skill', 'help', 'compact', 'goal', 'plan', 'clear', 'init']
  const clash = skills.filter((s) => !s.error && reserved.includes(s.name))
  if (clash.length) { console.log(`\n${C.r}✗${C.x} имена затеняют встроенные команды: ${clash.map((s) => s.name).join(', ')}`); problems += clash.length }

  // Политики: правила, а не измеряемые скиллы. Требуем валидный фронтматтер и
  // совпадение имени с именем файла — иначе правило не найти и не сослаться на него.
  const polDir = path.join(REPO, man.core_policies || 'core/policies')
  const polFiles = []
  const walkMd = (d) => {
    if (!fs.existsSync(d)) return
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
      const p = path.join(d, e.name)
      if (e.isDirectory()) walkMd(p)
      else if (e.name.endsWith('.md')) polFiles.push(p)
    }
  }
  walkMd(polDir)
  console.log(`\n${C.b}Политики${C.x} (${polFiles.length})`)
  for (const p of polFiles.sort()) {
    const text = fs.readFileSync(p, 'utf8')
    const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---/)
    const rel = path.relative(polDir, p)
    if (!m) { console.log(`  ${C.r}✗${C.x} ${rel} — нет фронтматтера`); problems++; continue }
    let meta
    try { meta = parseYaml(m[1]) } catch (e) { console.log(`  ${C.r}✗${C.x} ${rel} — битый YAML: ${e.message}`); problems++; continue }
    if (!meta.name || !meta.description) { console.log(`  ${C.r}✗${C.x} ${rel} — нужны name и description`); problems++; continue }
    const expect = path.basename(p, '.md')
    if (meta.name !== expect) { console.log(`  ${C.y}!${C.x} ${rel} — name «${meta.name}» не совпадает с именем файла`); warnings++ }
    if (String(meta.description).length < 40) { console.log(`  ${C.y}!${C.x} ${rel} — описание короче 40 символов, модель не поймёт, когда применять`); warnings++ }
  }
  if (!problems) console.log(`  ${C.d}структура политик в порядке${C.x}`)

  console.log(`\n${C.b}Ссылки в инструментах${C.x}`)
  const st = loadState(man)
  for (const [id, rec] of Object.entries(st.tools || {})) {
    let ok = 0, broken = 0
    for (const l of rec.links || []) {
      if (!fs.existsSync(l.dest)) { console.log(`  ${C.r}✗${C.x} ${id}: пропала ссылка ${l.dest.replace(os.homedir(), '~')}`); broken++; continue }
      if (!isSymlink(l.dest)) { console.log(`  ${C.y}!${C.x} ${id}: ${l.dest.replace(os.homedir(), '~')} — не ссылка (копия?)`); warnings++; continue }
      const cur = path.resolve(path.dirname(l.dest), fs.readlinkSync(l.dest))
      if (cur !== l.target) { console.log(`  ${C.r}✗${C.x} ${id}: ссылка ведёт не туда → ${cur}`); broken++; continue }
      ok++
    }
    console.log(`  ${broken ? C.r + '✗' + C.x : C.g + '✓' + C.x} ${id}: целых ${ok}${broken ? `, битых ${broken}` : ''}`)
    problems += broken
  }

  console.log(`\n${C.b}Манифест${C.x}`)
  for (const p of [man.core_skills, man.core_policies, man.core_playbooks, man.core_knowledge]) {
    if (!p) continue
    const abs = path.join(REPO, p)
    const exists = fs.existsSync(abs)
    console.log(`  ${exists ? `${C.g}✓${C.x}` : `${C.y}?${C.x}`} ${p}${exists ? '' : ' — ещё не создан'}`)
  }

  // Адаптеры против реальности.
  //
  // Манифест — это утверждение о том, как устроены инструменты. Утверждение,
  // которое никто не проверяет, устаревает молча: инструмент меняет раскладку,
  // а обвязка продолжает обещать несуществующее. Здесь объявленное сверяется
  // с фактическим — там, где это вообще проверяемо.
  console.log(`\n${C.b}Адаптеры против реальности${C.x}`)
  for (const [id, t] of Object.entries(man.tools || {})) {
    const foundCmd = hasCommand(t.detect_cmd)
    const foundDir = [].concat(t.detect_dirs || []).map(tilde).some((d) => fs.existsSync(d))
    if (!foundCmd && !foundDir) { console.log(`  ${C.d}·${C.x} ${id}: не установлен — пропущен`); continue }

    const notes = []
    for (const rs of [].concat(t.skill_roots || [])) {
      if (!rs.path) continue
      const abs = tilde(rs.path)
      if (!fs.existsSync(abs)) { notes.push(`объявлен каталог скиллов ${rs.path} — его нет`); continue }
      const rels = walkFiles(abs).filter((f) => f.endsWith('SKILL.md')).map((f) => path.relative(abs, f).split(path.sep).length)
      const depth2 = rels.filter((n) => n === 2).length
      const depth3 = rels.filter((n) => n === 3).length
      if (rs.layout === 'flat' && depth3 > 0) notes.push(`${rs.path}: ${depth3} вложенных скиллов — раскладка flat их не увидит`)
      if (rs.layout === 'nested' && depth3 === 0 && depth2 > 0) notes.push(`${rs.path}: скиллы лежат плоско — допустимо, обход рекурсивный`)
    }
    for (const f of [].concat(t.instruction_files || [])) {
      if (f && !fs.existsSync(tilde(f))) notes.push(`объявлен файл инструкций ${f} — его нет`)
    }
    // Ожидаемые места: инструмент читает файл, только если он создан.
    // Отсутствие — не расхождение, но полезно видеть, что обвязка туда ничего не кладёт.
    for (const f of [].concat(t.instruction_files_optional || [])) {
      if (f && !fs.existsSync(tilde(f))) console.log(`  ${C.d}·${C.x} ${id}: ${f} ещё не создан — обвязка его не создаёт`)
    }

    if (notes.length) for (const n of notes) { console.log(`  ${C.y}!${C.x} ${id}: ${n}`); warnings++ }
    else console.log(`  ${C.g}✓${C.x} ${id}: объявленное соответствует фактическому`)
  }

  console.log(`\n${C.b}Итог:${C.x} проблем ${problems}, предупреждений ${warnings}`)
  process.exit(problems ? 1 : 0)
}

function cmdOutdated(man) {
  const st = loadState(man)
  const skills = new Map(coreSkills(man).filter((s) => !s.error).map((s) => [s.name, s]))
  let n = 0
  for (const [id, rec] of Object.entries(st.tools || {})) {
    for (const l of rec.links || []) {
      const cur = skills.get(l.name)
      if (!cur) { console.log(`${C.y}удалён из ядра${C.x}  ${id}: ${l.name}`); n++; continue }
      if (cur.hash !== l.hash) { console.log(`${C.y}изменён${C.x}          ${id}: ${l.name}  ${C.d}${l.hash} → ${cur.hash}${C.x}`); n++ }
    }
  }
  console.log(n ? `\nрасхождений: ${n} — применить: harness update` : `${C.g}всё актуально${C.x}`)
}

function cmdUpdate(man) {
  console.log('Ссылки указывают на ядро напрямую, поэтому содержимое уже актуально.')
  console.log('Обновляю только записанные отпечатки и пересоздаю битые ссылки.\n')
  cmdInstall(man, 'all', true)
}

function cmdPrune(man) {
  const st = loadState(man)
  const live = new Set(coreSkills(man).filter((s) => !s.error).map((s) => s.name))
  let removed = 0
  for (const [id, rec] of Object.entries(st.tools || {})) {
    const keep = []
    for (const l of rec.links || []) {
      const orphan = !live.has(l.name)
      if (orphan && isSymlink(l.dest)) { fs.unlinkSync(l.dest); console.log(`${C.y}удалена ссылка${C.x} ${l.dest.replace(os.homedir(), '~')} (скилл убран из ядра)`); removed++; continue }
      keep.push(l)
    }
    rec.links = keep
  }
  saveState(man, st)
  console.log(removed ? `\nубрано: ${removed}` : 'нечего убирать')
  console.log(`${C.d}копии и чужие файлы не трогаются — только собственные ссылки${C.x}`)
}

function cmdInventory(man) {
  const st = loadState(man)
  const skills = coreSkills(man).filter((s) => !s.error)
  const out = {
    repo: REPO,
    manifestVersion: man.version,
    skills: skills.map((s) => ({ name: s.name, status: s.status, hash: s.hash })),
    tools: Object.fromEntries(Object.entries(st.tools || {}).map(([id, r]) => [id, (r.links || []).length])),
    generatedAt: new Date().toISOString()
  }
  console.log(JSON.stringify(out, null, 2))
}

/**
 * Самопроверка репозитория перед публикацией.
 *
 * Отвечает на один вопрос: можно ли этот коммит показывать. Публикация
 * необратима — удалённый коммит остаётся в форках, кэшах и сторонних архивах,
 * поэтому проверка идёт ДО коммита, а не после.
 *
 * Проверяется только то, что реально попадёт в репозиторий (git ls-files),
 * а не рабочая копия целиком.
 */
function cmdVerify(man) {
  let problems = 0, warnings = 0
  console.log(`${C.b}Самопроверка репозитория${C.x}\n`)

  let tracked
  try {
    tracked = execFileSync('git', ['-C', REPO, 'ls-files'], { encoding: 'utf8' }).split('\n').filter(Boolean)
  } catch {
    die('это не git-репозиторий — самопроверка невозможна')
  }
  console.log(`файлов под контролем версий: ${tracked.length}\n`)

  // 1. Секреты в отслеживаемых файлах.
  console.log(`${C.b}1. Секреты в файлах${C.x}`)
  const secretHits = []
  for (const rel of tracked) {
    const abs = path.join(REPO, rel)
    let text
    try { text = fs.readFileSync(abs, 'utf8') } catch { continue }
    const r = scanText(text)
    if (r.suspected.length) secretHits.push({ rel, what: r.suspected })
    else if (r.placeholder.length) { warnings++; console.log(`  ${C.d}·${C.x} ${rel} — примеры-заглушки: ${r.placeholder.join(', ')}`) }
  }
  if (secretHits.length) {
    for (const h of secretHits) console.log(`  ${C.r}✗${C.x} ${h.rel} — ${h.what.join(', ')}`)
    problems += secretHits.length
  } else console.log(`  ${C.g}✓${C.x} секретов не найдено`)

  // 2. Абсолютные пути с именем пользователя: утекает имя и структура дома.
  console.log(`\n${C.b}2. Абсолютные пути${C.x}`)
  const pathHits = []
  for (const rel of tracked) {
    if (rel === 'tools/harness') continue // в самом инструменте шаблоны путей — часть логики
    const abs = path.join(REPO, rel)
    let text
    try { text = fs.readFileSync(abs, 'utf8') } catch { continue }
    if (/\/Users\/[A-Za-z0-9._-]+\/(?!\s|$)/.test(text) || /\/home\/[A-Za-z0-9._-]+\//.test(text)) pathHits.push(rel)
  }
  if (pathHits.length) {
    for (const rel of pathHits) console.log(`  ${C.y}!${C.x} ${rel} — абсолютный путь; заменяется на ~ при импорте`)
    warnings += pathHits.length
  } else console.log(`  ${C.g}✓${C.x} абсолютных путей нет`)

  // 3. Защита .gitignore — проверяется САМИМ git, а не поиском подстроки:
  // интересует результат («этот путь игнорируется»), а не то, как записано правило.
  console.log(`\n${C.b}3. Защита .gitignore${C.x}`)
  const mustBeIgnored = [
    '.env', '.env.local', 'credentials.yaml', '.dsh/.credentials.yaml',
    'secrets.token', 'server.key', 'auth.json', 'oauth_creds.json',
    'sessions/session.v3.jsonl.zstd', 'attachments/file.png',
    'state.db', 'logs/agent.log', 'backup/settings.yaml.bak',
    'id_rsa', 'service-account.json', 'node_modules/pkg/index.js'
  ]
  const unprotected = []
  for (const rel of mustBeIgnored) {
    const r = spawnSync('git', ['-C', REPO, 'check-ignore', '-q', '--', rel])
    if (r.status !== 0) unprotected.push(rel)
  }
  if (unprotected.length) {
    for (const rel of unprotected) console.log(`  ${C.r}✗${C.x} не защищено: ${rel}`)
    problems += unprotected.length
  } else {
    console.log(`  ${C.g}✓${C.x} все ${mustBeIgnored.length} чувствительных путей игнорируются`)
  }

  // 4. Целостность ядра: ссылки в документах ведут на существующие файлы.
  console.log(`\n${C.b}4. Ссылки в документах${C.x}`)
  let brokenLinks = 0
  for (const rel of tracked.filter((f) => f.endsWith('.md'))) {
    const text = fs.readFileSync(path.join(REPO, rel), 'utf8')
    for (const m of text.matchAll(/\]\((?!https?:|mailto:|#)([^)]+)\)/g)) {
      const raw = m[1].trim()
      // В документации ссылки бывают шаблонами: `{output-dir}/NN-{type}.png`,
      // `DIRECT_URL`. Это не битые ссылки, а примеры — проверять их нечем.
      if (/[{}$<>*]/.test(raw)) continue
      if (/^[A-Z][A-Z0-9_]*$/.test(raw)) continue
      if (/\s/.test(raw)) continue
      const target = path.join(REPO, path.dirname(rel), raw.split('#')[0])
      if (!fs.existsSync(target)) { console.log(`  ${C.r}✗${C.x} ${rel} → ${raw}`); brokenLinks++ }
    }
  }
  if (brokenLinks) problems += brokenLinks
  else console.log(`  ${C.g}✓${C.x} битых ссылок нет`)

  console.log(`\n${C.b}Итог:${C.x} проблем ${problems}, предупреждений ${warnings}`)
  if (problems) {
    console.log(`${C.r}Публиковать этот коммит нельзя.${C.x} Сначала устранить проблемы выше.`)
    process.exit(1)
  }
  console.log(`${C.g}Коммит можно публиковать.${C.x}`)
}


// ─── Разведка и перенос скиллов ─────────────────────────────────────────────
// Перенос в публичный репозиторий необратим, поэтому проверка идёт ДО копирования:
// найденный секрет — отказ, а не «предупреждение в отчёте». Значения секретов
// никогда не печатаются: только имя шаблона и имя файла.

const SECRET_PATTERNS = [
  ['ключ провайдера (sk-)', /\bsk-[A-Za-z0-9_-]{16,}/],
  ['токен GitHub', /\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}/],
  ['ключ AWS', /\bAKIA[0-9A-Z]{16}\b/],
  ['ключ Google', /\bAIza[0-9A-Za-z_-]{30,}/],
  ['токен Slack', /\bxox[baprs]-[A-Za-z0-9-]{10,}/],
  ['токен Telegram-бота', /\b\d{8,12}:[A-Za-z0-9_-]{30,}\b/],
  ['приватный ключ', /-----BEGIN [A-Z ]*PRIVATE KEY-----/],
  ['пароль в строке подключения', /\b[a-z]+:\/\/[^\s:@/]+:[^\s:@/]{6,}@/i],
  ['секрет в конфиге', /^\s*(api[_-]?key|secret|token|password|passwd)\s*[:=]\s*["']?[A-Za-z0-9_\-./+]{16,}/im],
]

const PERSONAL_PATTERNS = [
  ['абсолютный путь с именем пользователя', /\/Users\/[A-Za-z0-9._-]+\//],
  // Личная инфраструктура: адрес туннеля и имя узла в приватной сети — это
  // не «просто ссылка». Публичный адрес туннеля плюс PIN даёт доступ к машине,
  // а имя узла раскрывает устройство сети. Сканер обязан их видеть.
  ['публичный адрес туннеля', /https?:\/\/[a-z0-9-]+\.ngrok(?:-free)?\.(?:dev|io|app)/i],
  ['имя узла приватной сети', /[a-z0-9-]+\.tail[0-9a-f]{6,}\.ts\.net/i],
  ['адрес в сети Tailscale', /\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b/],
  ['домашний путь Linux', /\/home\/[A-Za-z0-9._-]+\//],
  ['электронная почта', /\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/],
  ['телефон', /(?:\+7|\b8)[\s(-]?\d{3}[\s)-]?\d{3}[\s-]?\d{2}[\s-]?\d{2}\b/],
  ['ID чата Telegram', /\b-?100\d{10,}\b/],
]

/** Энтропия Шеннона: отличает заглушку (`sk-xxxx…`) от настоящего ключа. */
function entropy(s) {
  const freq = {}
  for (const ch of s) freq[ch] = (freq[ch] || 0) + 1
  let h = 0
  for (const k in freq) { const p = freq[k] / s.length; h -= p * Math.log2(p) }
  return h
}

/**
 * Просканировать текст.
 *
 * Совпадения делятся на две группы, потому что цена ошибки несимметрична:
 *  - `suspected` — похоже на настоящий секрет (высокая энтропия): перенос запрещён;
 *  - `placeholder` — низкая энтропия, то есть пример вида `sk-xxxx…`: перенос
 *    разрешён, но помечается — иначе такие примеры будут вечно ловиться
 *    сканерами секретов на GitHub.
 * Значения не возвращаются и не печатаются — только метки шаблонов.
 */
function scanText(text) {
  const out = { suspected: [], placeholder: [], personal: [] }
  for (const [label, re] of SECRET_PATTERNS) {
    const flags = re.flags.includes('g') ? re.flags : re.flags + 'g'
    const found = [...text.matchAll(new RegExp(re.source, flags))]
    if (!found.length) continue
    let worst = 0
    for (const m of found) {
      const value = m.slice(1).find((g) => g && g.length > 8) || m[0]
      worst = Math.max(worst, entropy(String(value)))
    }
    if (worst >= 3) out.suspected.push(label)
    else out.placeholder.push(label)
  }
  for (const [label, re] of PERSONAL_PATTERNS) if (re.test(text)) out.personal.push(label)
  return out
}

/** Обезличить текст: домашние пути → ~, значения секретов не трогаем (мы их не переносим). */
function sanitizeText(text) {
  return text
    .replace(/\/Users\/[A-Za-z0-9._-]+\//g, '~/')
    .replace(/\/home\/[A-Za-z0-9._-]+\//g, '~/')
}

function walkFiles(dir) {
  const out = []
  const walk = (d) => {
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
      if (e.name === '.git' || e.name === 'node_modules') continue
      const p = path.join(d, e.name)
      if (e.isDirectory()) walk(p)
      else out.push(p)
    }
  }
  if (fs.existsSync(dir)) walk(dir)
  return out
}

function inspectSkillDir(dir) {
  const sk = readSkill(dir)
  if (sk.error) return { dir, error: sk.error }
  const files = walkFiles(dir)
  const suspected = new Set(), placeholder = new Set(), personal = new Set()
  let bytes = 0
  for (const f of files) {
    bytes += fs.statSync(f).size
    if (bytes > 2 * 1024 * 1024) continue // крупные ресурсы не читаем построчно
    let text = ''
    try { text = fs.readFileSync(f, 'utf8') } catch { continue }
    const r = scanText(text)
    r.suspected.forEach((v) => suspected.add(v))
    r.placeholder.forEach((v) => placeholder.add(v))
    r.personal.forEach((v) => personal.add(v))
  }
  return {
    dir, name: sk.name, status: sk.status, files: files.length, bytes,
    suspected: [...suspected], placeholder: [...placeholder], personal: [...personal]
  }
}

function verdictOf(info) {
  if (info.error) return 'битый'
  if (info.suspected.length) return 'ОТКАЗ'
  if (info.personal.length) return 'санитизация'
  if (info.placeholder.length) return 'примеры-ключей'
  return 'чисто'
}

function cmdScan(man, root, docsMode) {
  if (!root || root === 'all') die('укажите каталог: harness scan <каталог> [--docs]')
  const rootAbs = tilde(root)
  if (!fs.existsSync(rootAbs)) die(`нет такого каталога: ${rootAbs}`)

  // Режим --docs: проверяем не скиллы, а обычные документы. Нужен при переносе
  // playbook'ов и конспектов: они не являются скиллами, но утечь могут так же.
  if (docsMode) return cmdScanDocs(rootAbs)

  const dirs = []
  const walk = (d) => {
    if (fs.existsSync(path.join(d, 'SKILL.md'))) { dirs.push(d); return }
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
      if (!e.isDirectory() || e.name === '.git' || e.name === 'node_modules') continue
      if (e.name.startsWith('.')) continue // .archive, .hub, .removed_* — не действующие скиллы
      walk(path.join(d, e.name))
    }
  }
  walk(rootAbs)

  console.log(`${C.b}Разведка:${C.x} ${rootAbs.replace(os.homedir(), '~')}`)
  console.log(`найдено скиллов: ${dirs.length}\n`)

  const infos = dirs.map(inspectSkillDir)
  const byVerdict = { 'чисто': [], 'примеры-ключей': [], 'санитизация': [], 'ОТКАЗ': [], 'битый': [] }
  for (const i of infos) byVerdict[verdictOf(i)].push(i)

  for (const [v, list] of Object.entries(byVerdict)) {
    if (!list.length) continue
    const color = v === 'ОТКАЗ' ? C.r : v === 'чисто' ? C.g : C.y
    console.log(`${color}${v}${C.x} — ${list.length}`)
    for (const i of list.slice(0, 60)) {
      const rel = i.dir.replace(os.homedir(), '~')
      const why = i.error ? i.error
        : i.suspected.length ? `ПОДОЗРЕНИЕ НА СЕКРЕТ: ${i.suspected.join(', ')}`
        : i.personal.length ? `персональное: ${i.personal.join(', ')}`
        : i.placeholder.length ? `примеры-заглушки: ${i.placeholder.join(', ')}`
        : `${i.files} файлов, ${(i.bytes / 1024).toFixed(0)} КБ`
      console.log(`  ${(i.name || path.basename(i.dir)).padEnd(34)} ${C.d}${why}${C.x}`)
      if (i.name) console.log(`  ${' '.repeat(34)} ${C.d}${rel}${C.x}`)
    }
    if (list.length > 60) console.log(`  ${C.d}… и ещё ${list.length - 60}${C.x}`)
    console.log('')
  }
  console.log(`${C.d}значения секретов не читались и не печатались — только имена шаблонов${C.x}`)
  console.log(`${C.d}переносить: harness import <путь>${C.x}`)
}


/** Разведка обычных документов: что можно переносить, что требует санитизации. */
function cmdScanDocs(rootAbs) {
  // Корнем может быть и одиночный файл: проверять один документ — обычный случай.
  const all = fs.statSync(rootAbs).isFile() ? [rootAbs] : walkFiles(rootAbs)
  const files = all.filter((f) => f.endsWith('.md') || f.endsWith('.sh') || f.endsWith('.mjs') || f.endsWith('.js') || f.endsWith('.py'))
  console.log(`${C.b}Разведка документов:${C.x} ${rootAbs.replace(os.homedir(), '~')}`)
  console.log(`файлов: ${files.length}\n`)

  const rows = []
  for (const f of files) {
    let text = ''
    try { text = fs.readFileSync(f, 'utf8') } catch { continue }
    const r = scanText(text)
    const abs = /\/Users\/[A-Za-z0-9._-]+\//.test(text) || /\/home\/[A-Za-z0-9._-]+\//.test(text)
    const verdict = r.suspected.length ? 'ОТКАЗ' : (r.personal.length || abs) ? 'санитизация' : r.placeholder.length ? 'примеры-ключей' : 'чисто'
    rows.push({ f, verdict, why: r.suspected.join(', ') || r.personal.join(', ') || (abs ? 'абсолютный путь' : '') || r.placeholder.join(', ') })
  }

  const order = { 'ОТКАЗ': 0, 'санитизация': 1, 'примеры-ключей': 2, 'чисто': 3 }
  rows.sort((a, b) => order[a.verdict] - order[b.verdict] || a.f.localeCompare(b.f))
  const counts = {}
  for (const r of rows) counts[r.verdict] = (counts[r.verdict] || 0) + 1
  console.log(Object.entries(counts).map(([k, v]) => `${k}: ${v}`).join(' · ') + '\n')

  for (const r of rows) {
    if (r.verdict === 'чисто') continue
    const color = r.verdict === 'ОТКАЗ' ? C.r : r.verdict === 'санитизация' ? C.y : C.d
    console.log(`  ${color}${r.verdict}${C.x} ${r.f.replace(rootAbs, '.').replace(os.homedir(), '~')}`)
    if (r.why) console.log(`         ${C.d}${r.why}${C.x}`)
  }
  const clean = rows.filter((r) => r.verdict === 'чисто')
  console.log(`\n${C.g}чистых файлов: ${clean.length}${C.x} — их можно переносить как есть`)
  console.log(`${C.d}значения секретов не читались и не печатались${C.x}`)
}

function cmdImport(man, src, dryRun) {
  if (!src) die('укажите путь к скиллу: harness import <путь> [--dry-run]')
  const srcAbs = tilde(src)
  if (!fs.existsSync(srcAbs)) die(`нет такого пути: ${srcAbs}`)
  const info = inspectSkillDir(srcAbs)

  console.log(`${C.b}Импорт:${C.x} ${srcAbs.replace(os.homedir(), '~')}`)
  if (info.error) die(`скилл не годен: ${info.error}`)
  console.log(`  имя:     ${info.name}`)
  console.log(`  статус:  ${info.status}${info.status === 'candidate' ? ' (нет EVIDENCE.md — попадёт как кандидат)' : ''}`)
  console.log(`  файлов:  ${info.files}, ${(info.bytes / 1024).toFixed(0)} КБ`)

  if (info.suspected.length) {
    console.log(`\n${C.r}ОТКАЗ.${C.x} Похоже на настоящие секреты: ${info.suspected.join(', ')}`)
    console.log('Перенос в публичный репозиторий необратим — импорт остановлен.')
    console.log(`${C.d}Ключ, попавший в файл, сначала отзывается, потом переносится содержимое.${C.x}`)
    process.exit(2)
  }
  if (info.placeholder.length) {
    console.log(`\n${C.d}Примеры-заглушки ключей (${info.placeholder.join(', ')}) — переносить можно, но лучше заменить на многоточие: сканеры секретов на них срабатывают.${C.x}`)
  }
  if (info.personal.length) {
    console.log(`\n${C.y}Требуется санитизация:${C.x} ${info.personal.join(', ')}`)
    console.log(`${C.d}Абсолютные пути будут заменены на ~. Остальные находки требуют внимания вручную.${C.x}`)
  }

  const dest = path.join(REPO, man.core_skills || 'core/skills', info.name)
  if (fs.existsSync(dest)) {
    console.log(`\n${C.y}Уже есть в ядре:${C.x} ${dest.replace(REPO, '.')} — импорт не перезаписывает.`)
    console.log(`${C.d}Сравните вручную или удалите существующий каталог осознанно.${C.x}`)
    process.exit(3)
  }

  if (dryRun) {
    console.log(`\n${C.b}--dry-run${C.x}: было бы скопировано в ${dest.replace(REPO, '.')}`)
    return
  }

  fs.mkdirSync(dest, { recursive: true })
  let sanitized = 0
  for (const f of walkFiles(srcAbs)) {
    const rel = path.relative(srcAbs, f)
    const target = path.join(dest, rel)
    fs.mkdirSync(path.dirname(target), { recursive: true })
    let text = null
    try { text = fs.readFileSync(f, 'utf8') } catch { /* бинарный ресурс — копируем как есть */ }
    if (text !== null) {
      const clean = sanitizeText(text)
      if (clean !== text) sanitized++
      fs.writeFileSync(target, clean)
    } else {
      fs.copyFileSync(f, target)
    }
  }
  console.log(`\n${C.g}Перенесено${C.x} в ${dest.replace(REPO, '.')}${sanitized ? `, файлов с обезличенными путями: ${sanitized}` : ''}`)
  console.log(`${C.d}статус «кандидат»: без EVIDENCE.md скилл не устанавливается по умолчанию${C.x}`)
  console.log(`${C.d}проверить: harness doctor${C.x}`)
}


/**
 * Создать заготовку скилла из шаблона.
 *
 * Смысл: порог доказательности не должен быть бюрократией. Заготовка сразу
 * содержит и SKILL.md, и EVIDENCE.md с полями замера — заполнить проще,
 * чем вспоминать, что требуется.
 */
function cmdNew(man, name) {
  if (!name) die('укажите имя: harness new <имя-в-kebab-case>')
  if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(name)) {
    die(`имя должно быть в kebab-case (строчные буквы, цифры, дефисы): получено «${name}»`)
  }
  const tpl = path.join(REPO, man.core_skills || 'core/skills', '_template')
  if (!fs.existsSync(tpl)) die(`нет шаблона: ${tpl.replace(REPO, '.')}`)
  const dest = path.join(REPO, man.core_skills || 'core/skills', name)
  if (fs.existsSync(dest)) die(`уже существует: ${dest.replace(REPO, '.')}`)

  fs.mkdirSync(dest, { recursive: true })
  for (const file of fs.readdirSync(tpl)) {
    const text = fs.readFileSync(path.join(tpl, file), 'utf8')
    fs.writeFileSync(path.join(dest, file), text.replace(/имя-скилла-в-kebab-case|имя-скилла/g, name))
  }
  console.log(`${C.g}Создано:${C.x} ${dest.replace(REPO, '.')}`)
  console.log(`
Дальше по порядку:
  1. Заполнить description — это единственное, что модель видит заранее.
     Сначала условие применения, потом суть. Без общих слов.
  2. Написать тело процедуры и раздел «Когда НЕ применять».
  3. Замерить: без скилла и со скиллом, три метрики, не меньше трёх прогонов.
  4. Заполнить EVIDENCE.md — до этого скилл остаётся кандидатом
     и не устанавливается.
  5. Проверить: harness doctor`)
}


/**
 * Перенести отдельный документ (playbook или конспект) в соответствующей слой ядра.
 *
 * Отличие от скилла: у документа нет фронтматтера и нет замера — он не является
 * процедурой с доказанной пользой. Поэтому проверка та же (секреты, пути),
 * а слой выбирается явно: playbooks или knowledge.
 */
function cmdImportDoc(man, src, layer, dryRun) {
  if (!src) die('укажите файл: harness import <файл.md> --doc --layer playbooks|knowledge')
  const srcAbs = tilde(src)
  if (!fs.existsSync(srcAbs) || !fs.statSync(srcAbs).isFile()) die(`нет такого файла: ${srcAbs}`)
  // Слой выбирается явно: playbooks и knowledge — переносимое; путь в adapters/ —
  // когда документ описывает конкретный деплой, а не общий случай.
  const okLayer = ['playbooks', 'knowledge'].includes(layer) || /^adapters\/[a-z0-9-]+$/.test(layer || '')
  if (!okLayer) die('--layer должен быть playbooks, knowledge или adapters/<инструмент>')

  const text = fs.readFileSync(srcAbs, 'utf8')
  const r = scanText(text)
  const base = path.basename(srcAbs)

  const layerDir = layer.startsWith('adapters/') ? layer : `core/${layer}`
  console.log(`${C.b}Перенос документа:${C.x} ${base} → ${layerDir}/`)
  console.log(`  размер: ${(text.length / 1024).toFixed(0)} КБ`)

  if (r.suspected.length) {
    console.log(`\n${C.r}ОТКАЗ.${C.x} Похоже на настоящие секреты: ${r.suspected.join(', ')}`)
    process.exit(2)
  }
  if (r.personal.length) console.log(`  ${C.y}санитизация:${C.x} ${r.personal.join(', ')}`)
  if (r.placeholder.length) console.log(`  ${C.d}примеры-заглушки:${r.placeholder.join(', ')}${C.x}`)

  const dest = path.join(REPO, layerDir, base)
  if (fs.existsSync(dest)) {
    console.log(`\n${C.y}Уже есть:${C.x} ${layerDir}/${base} — не перезаписываю.`)
    process.exit(3)
  }
  if (dryRun) {
    console.log(`\n${C.b}--dry-run${C.x}: было бы записано в ${layerDir}/${base}`)
    return
  }

  // Обезличиваем домашние пути; остальное содержимое не трогаем.
  const clean = sanitizeText(text)
  fs.mkdirSync(path.dirname(dest), { recursive: true })
  fs.writeFileSync(dest, clean)
  const fixed = clean !== text ? ', пути обезличены' : ''
  console.log(`\n${C.g}Перенесено${C.x} в ${layerDir}/${base}${fixed}`)
  console.log(`${C.d}проверить: harness verify && harness doctor${C.x}`)
}

// ─── Вход ───────────────────────────────────────────────────────────────────
const [, , cmd = 'help', ...rest] = process.argv
const includeCandidates = rest.includes('--candidates')
const target = rest.find((a) => !a.startsWith('--')) || 'all'
const man = loadManifest()

switch (cmd) {
  case 'detect': cmdDetect(man); break
  case 'install': cmdInstall(man, target, includeCandidates); break
  case 'doctor': cmdDoctor(man); break
  case 'outdated': cmdOutdated(man); break
  case 'update': cmdUpdate(man); break
  case 'prune': cmdPrune(man); break
  case 'inventory': cmdInventory(man); break
  case 'new': cmdNew(man, rest.find((a) => !a.startsWith('--'))); break
  case 'verify': cmdVerify(man); break
  case 'scan': cmdScan(man, target, rest.includes('--docs')); break
  case 'import': {
    const src = rest.filter((a) => !a.startsWith('--'))[0]
    const idx = rest.indexOf('--layer')
    const layer = idx >= 0 ? rest[idx + 1] : undefined
    if (rest.includes('--doc')) cmdImportDoc(man, src, layer, rest.includes('--dry-run'))
    else cmdImport(man, src, rest.includes('--dry-run'))
    break
  }
  default:
    console.log(`harness — обвязка агентов

  harness detect                 какие инструменты есть на машине
  harness install [инструмент]   подключить ядро (all — во все найденные)
       --candidates              включить скиллы без EVIDENCE.md
  harness doctor                 проверки: YAML, дубли, коллизии, битые ссылки
  harness outdated               что в ядре изменилось с момента установки
  harness update                 пересоздать ссылки и обновить отпечатки
  harness prune                  убрать свои ссылки на исчезнувшие скиллы
  harness inventory              машинный отчёт об установленном
  harness new <имя>              создать заготовку скилла из шаблона
  harness verify                 самопроверка перед публикацией: секреты, пути, ссылки
  harness scan <каталог>         разведка: какие скиллы можно перенести
       --docs                    проверять обычные документы, а не скиллы
  harness import <путь>          перенести скилл в ядро (--dry-run — только показать)
  harness import <файл> --doc --layer <playbooks|knowledge>   перенести документ
`)
}
