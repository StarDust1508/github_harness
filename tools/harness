}

function cmdPrune(man) {
  const st = loadState(man)
  const live = new Set(coreSkills(man).filter((s) => !s.error).map((s) => s.name))
  let removed = 0
  for (const [id, rec] of Object.entries(st.tools || {})) {
    const keep = []
    for (const l of rec.links || []) {
      const orphan = !live.has(l.name)
      if (orphan && isSymlink(l.dest)) { fs.unlinkSync(l.dest); console.log(`${C.y}удалена ссылка${C.x} ${l.dest.replace(os.homedir(), '~')} (скилл убран из ядра)`); removed++; continue }
      keep.push(l)
    }
    rec.links = keep
  }
  saveState(man, st)
  console.log(removed ? `\nубрано: ${removed}` : 'нечего убирать')
  console.log(`${C.d}копии и чужие файлы не трогаются — только собственные ссылки${C.x}`)
}

function cmdInventory(man) {
  const st = loadState(man)
  const skills = coreSkills(man).filter((s) => !s.error)
  const out = {
    repo: REPO,
    manifestVersion: man.version,
    skills: skills.map((s) => ({ name: s.name, status: s.status, hash: s.hash })),
    tools: Object.fromEntries(Object.entries(st.tools || {}).map(([id, r]) => [id, (r.links || []).length])),
    generatedAt: new Date().toISOString()
  }
  console.log(JSON.stringify(out, null, 2))
}

/**
 * Самопроверка репозитория перед публикацией.
 *
 * Отвечает на один вопрос: можно ли этот коммит показывать. Публикация
 * необратима — удалённый коммит остаётся в форках, кэшах и сторонних архивах,
 * поэтому проверка идёт ДО коммита, а не после.
 *
 * Проверяется только то, что реально попадёт в репозиторий (git ls-files),
 * а не рабочая копия целиком.
 */
function cmdVerify(man) {
  let problems = 0, warnings = 0
  console.log(`${C.b}Самопроверка репозитория${C.x}\n`)

  let tracked
  try {
    tracked = execFileSync('git', ['-C', REPO, 'ls-files'], { encoding: 'utf8' }).split('\n').filter(Boolean)
  } catch {
    die('это не git-репозиторий — самопроверка невозможна')
  }
  console.log(`файлов под контролем версий: ${tracked.length}\n`)

  // 1. Секреты в отслеживаемых файлах.
  console.log(`${C.b}1. Секреты в файлах${C.x}`)
  const secretHits = []
  for (const rel of tracked) {
    const abs = path.join(REPO, rel)
    let text
    try { text = fs.readFileSync(abs, 'utf8') } catch { continue }
    const r = scanText(text)
    if (r.suspected.length) secretHits.push({ rel, what: r.suspected })
    else if (r.placeholder.length) { warnings++; console.log(`  ${C.d}·${C.x} ${rel} — примеры-заглушки: ${r.placeholder.join(', ')}`) }
  }
  if (secretHits.length) {
    for (const h of secretHits) console.log(`  ${C.r}✗${C.x} ${h.rel} — ${h.what.join(', ')}`)
    problems += secretHits.length
  } else console.log(`  ${C.g}✓${C.x} секретов не найдено`)

  // 2. Абсолютные пути с именем пользователя: утекает имя и структура дома.
  console.log(`\n${C.b}2. Абсолютные пути${C.x}`)
  const pathHits = []
  for (const rel of tracked) {
    if (rel === 'tools/harness') continue // в самом инструменте шаблоны путей — часть логики
    const abs = path.join(REPO, rel)
    let text
    try { text = fs.readFileSync(abs, 'utf8') } catch { continue }
    if (/\/Users\/[A-Za-z0-9._-]+\/(?!\s|$)/.test(text) || /\/home\/[A-Za-z0-9._-]+\//.test(text)) pathHits.push(rel)
  }
  if (pathHits.length) {
    for (const rel of pathHits) console.log(`  ${C.y}!${C.x} ${rel} — абсолютный путь; заменяется на ~ при импорте`)
    warnings += pathHits.length
  } else console.log(`  ${C.g}✓${C.x} абсолютных путей нет`)

  // 3. Защита .gitignore — проверяется САМИМ git, а не поиском подстроки:
  // интересует результат («этот путь игнорируется»), а не то, как записано правило.
  console.log(`\n${C.b}3. Защита .gitignore${C.x}`)
  const mustBeIgnored = [
    '.env', '.env.local', 'credentials.yaml', '.dsh/.credentials.yaml',
    'secrets.token', 'server.key', 'auth.json', 'oauth_creds.json',
    'sessions/session.v3.jsonl.zstd', 'attachments/file.png',
    'state.db', 'logs/agent.log', 'backup/settings.yaml.bak',
    'id_rsa', 'service-account.json', 'node_modules/pkg/index.js'
  ]
  const unprotected = []
  for (const rel of mustBeIgnored) {
    const r = spawnSync('git', ['-C', REPO, 'check-ignore', '-q', '--', rel])
    if (r.status !== 0) unprotected.push(rel)
  }
  if (unprotected.length) {
    for (const rel of unprotected) console.log(`  ${C.r}✗${C.x} не защищено: ${rel}`)
    problems += unprotected.length
  } else {
    console.log(`  ${C.g}✓${C.x} все ${mustBeIgnored.length} чувствительных путей игнорируются`)
  }

  // 4. Целостность ядра: ссылки в документах ведут на существующие файлы.
  console.log(`\n${C.b}4. Ссылки в документах${C.x}`)
  let brokenLinks = 0
  for (const rel of tracked.filter((f) => f.endsWith('.md'))) {
    const text = fs.readFileSync(path.join(REPO, rel), 'utf8')
    for (const m of text.matchAll(/\]\((?!https?:|mailto:|#)([^)]+)\)/g)) {
      const raw = m[1].trim()
      // В документации ссылки бывают шаблонами: `{output-dir}/NN-{type}.png`,
      // `DIRECT_URL`. Это не битые ссылки, а примеры — проверять их нечем.
      if (/[{}$<>*]/.test(raw)) continue
      if (/^[A-Z][A-Z0-9_]*$/.test(raw)) continue
      if (/\s/.test(raw)) continue
      const target = path.join(REPO, path.dirname(rel), raw.split('#')[0])
      if (!fs.existsSync(target)) { console.log(`  ${C.r}✗${C.x} ${rel} → ${raw}`); brokenLinks++ }
    }
  }
  if (brokenLinks) problems += brokenLinks
  else console.log(`  ${C.g}✓${C.x} битых ссылок нет`)

  console.log(`\n${C.b}Итог:${C.x} проблем ${problems}, предупреждений ${warnings}`)
  if (problems) {
    console.log(`${C.r}Публиковать этот коммит нельзя.${C.x} Сначала устранить проблемы выше.`)
    process.exit(1)
  }
  console.log(`${C.g}Коммит можно публиковать.${C.x}`)
}


// ─── Разведка и перенос скиллов ─────────────────────────────────────────────
// Перенос в публичный репозиторий необратим, поэтому проверка идёт ДО копирования:
// найденный секрет — отказ, а не «предупреждение в отчёте». Значения секретов
// никогда не печатаются: только имя шаблона и имя файла.

const SECRET_PATTERNS = [
  ['ключ провайдера (sk-)', /\bsk-[A-Za-z0-9_-]{16,}/],
  ['токен GitHub', /\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}|\bgithub_pat_[A-Za-z0-9_]{20,}/],
  ['ключ AWS', /\bAKIA[0-9A-Z]{16}\b/],
  ['ключ Google', /\bAIza[0-9A-Za-z_-]{30,}/],
  ['токен Slack', /\bxox[baprs]-[A-Za-z0-9-]{10,}/],
  ['токен Telegram-бота', /\b\d{8,12}:[A-Za-z0-9_-]{30,}\b/],
  ['приватный ключ', /-----BEGIN [A-Z ]*PRIVATE KEY-----/],
  ['пароль в строке подключения', /\b[a-z]+:\/\/[^\s:@/]+:[^\s:@/]{6,}@/i],
  ['секрет в конфиге', /^\s*(api[_-]?key|secret|token|password|passwd)\s*[:=]\s*["']?[A-Za-z0-9_\-./+]{16,}/im],
]

const PERSONAL_PATTERNS = [
  ['абсолютный путь с именем пользователя', /\/Users\/[A-Za-z0-9._-]+\//],
  // Личная инфраструктура: адрес туннеля и имя узла в приватной сети — это
  // не «просто ссылка». Публичный адрес туннеля плюс PIN даёт доступ к машине,
  // а имя узла раскрывает устройство сети. Сканер обязан их видеть.
  ['публичный адрес туннеля', /https?:\/\/[a-z0-9-]+\.ngrok(?:-free)?\.(?:dev|io|app)/i],
  ['имя узла приватной сети', /[a-z0-9-]+\.tail[0-9a-f]{6,}\.ts\.net/i],
  ['адрес в сети Tailscale', /\b100\.(?:6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b/],
  ['домашний путь Linux', /\/home\/[A-Za-z0-9._-]+\//],
  ['электронная почта', /\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/],
  ['телефон', /(?:\+7|\b8)[\s(-]?\d{3}[\s)-]?\d{3}[\s-]?\d{2}[\s-]?\d{2}\b/],
  ['ID чата Telegram', /\b-?100\d{10,}\b/],
]

/** Энтропия Шеннона: отличает заглушку (`sk-xxxx…`) от настоящего ключа. */
function entropy(s) {
  const freq = {}
  for (const ch of s) freq[ch] = (freq[ch] || 0) + 1
  let h = 0
  for (const k in freq) { const p = freq[k] / s.length; h -= p * Math.log2(p) }
  return h
}

/**
 * Просканировать текст.
 *
 * Совпадения делятся на две группы, потому что цена ошибки несимметрична:
 *  - `suspected` — похоже на настоящий секрет (высокая энтропия): перенос запрещён;
 *  - `placeholder` — низкая энтропия, то есть пример вида `sk-xxxx…`: перенос
 *    разрешён, но помечается — иначе такие примеры будут вечно ловиться
 *    сканерами секретов на GitHub.
 * Значения не возвращаются и не печатаются — только метки шаблонов.
 */
function scanText(text) {
  const out = { suspected: [], placeholder: [], personal: [] }
  for (const [label, re] of SECRET_PATTERNS) {
    const flags = re.flags.includes('g') ? re.flags : re.flags + 'g'
    const found = [...text.matchAll(new RegExp(re.source, flags))]
    if (!found.length) continue
    let worst = 0
    for (const m of found) {
      const value = m.slice(1).find((g) => g && g.length > 8) || m[0]
      worst = Math.max(worst, entropy(String(value)))
    }
    if (worst >= 3) out.suspected.push(label)
    else out.placeholder.push(label)
  }
  for (const [label, re] of PERSONAL_PATTERNS) if (re.test(text)) out.personal.push(label)
  return out
}

/** Обезличить текст: домашние пути → ~, значения секретов не трогаем (мы их не переносим). */
function sanitizeText(text) {
  return text
    .replace(/\/Users\/[A-Za-z0-9._-]+\//g, '~/')
    .replace(/\/home\/[A-Za-z0-9._-]+\//g, '~/')
}

function walkFiles(dir) {
  const out = []
  const walk = (d) => {
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
      if (e.name === '.git' || e.name === 'node_modules') continue
      const p = path.join(d, e.name)
      if (e.isDirectory()) walk(p)
      else out.push(p)
    }
  }
  if (fs.existsSync(dir)) walk(dir)
  return out
}

function inspectSkillDir(dir) {
  const sk = readSkill(dir)
  if (sk.error) return { dir, error: sk.error }
  const files = walkFiles(dir)
  const suspected = new Set(), placeholder = new Set(), personal = new Set()
  let bytes = 0
  for (const f of files) {
    bytes += fs.statSync(f).size
    if (bytes > 2 * 1024 * 1024) continue // крупные ресурсы не читаем построчно
    let text = ''
    try { text = fs.readFileSync(f, 'utf8') } catch { continue }
    const r = scanText(text)
    r.suspected.forEach((v) => suspected.add(v))
    r.placeholder.forEach((v) => placeholder.add(v))
    r.personal.forEach((v) => personal.add(v))
  }
  return {
    dir, name: sk.name, status: sk.status, files: files.length, bytes,
    suspected: [...suspected], placeholder: [...placeholder], personal: [...personal]
  }
}

function verdictOf(info) {
  if (info.error) return 'битый'
  if (info.suspected.length) return 'ОТКАЗ'
  if (info.personal.length) return 'санитизация'
  if (info.placeholder.length) return 'примеры-ключей'
  return 'чисто'
}

function cmdScan(man, root, docsMode) {
  if (!root || root === 'all') die('укажите каталог: harness scan <каталог> [--docs]')
  const rootAbs = tilde(root)
  if (!fs.existsSync(rootAbs)) die(`нет такого каталога: ${rootAbs}`)

  // Режим --docs: проверяем не скиллы, а обычные документы. Нужен при переносе
  // playbook'ов и конспектов: они не являются скиллами, но утечь могут так же.
  if (docsMode) return cmdScanDocs(rootAbs)

  const dirs = []
  const walk = (d) => {
    if (fs.existsSync(path.join(d, 'SKILL.md'))) { dirs.push(d); return }
    for (const e of fs.readdirSync(d, { withFileTypes: true })) {
      if (!e.isDirectory() || e.name === '.git' || e.name === 'node_modules') continue
      if (e.name.startsWith('.')) continue // .archive, .hub, .removed_* — не действующие скиллы
      walk(path.join(d, e.name))
    }
  }
  walk(rootAbs)

  console.log(`${C.b}Разведка:${C.x} ${rootAbs.replace(os.homedir(), '~')}`)
  console.log(`найдено скиллов: ${dirs.length}\n`)

  const infos = dirs.map(inspectSkillDir)
  const byVerdict = { 'чисто': [], 'примеры-ключей': [], 'санитизация': [], 'ОТКАЗ': [], 'битый': [] }
  for (const i of infos) byVerdict[verdictOf(i)].push(i)

  for (const [v, list] of Object.entries(byVerdict)) {
    if (!list.length) continue
    const color = v === 'ОТКАЗ' ? C.r : v === 'чисто' ? C.g : C.y
    console.log(`${color}${v}${C.x} — ${list.length}`)
    for (const i of list.slice(0, 60)) {
      const rel = i.dir.replace(os.homedir(), '~')
      const why = i.error ? i.error
        : i.suspected.length ? `ПОДОЗРЕНИЕ НА СЕКРЕТ: ${i.suspected.join(', ')}`
        : i.personal.length ? `персональное: ${i.personal.join(', ')}`
        : i.placeholder.length ? `примеры-заглушки: ${i.placeholder.join(', ')}`
        : `${i.files} файлов, ${(i.bytes / 1024).toFixed(0)} КБ`
      console.log(`  ${(i.name || path.basename(i.dir)).padEnd(34)} ${C.d}${why}${C.x}`)
      if (i.name) console.log(`  ${' '.repeat(34)} ${C.d}${rel}${C.x}`)
    }
    if (list.length > 60) console.log(`  ${C.d}… и ещё ${list.length - 60}${C.x}`)
    console.log('')
  }
  console.log(`${C.d}значения секретов не читались и не печатались — только имена шаблонов${C.x}`)
  console.log(`${C.d}переносить: harness import <путь>${C.x}`)
}


/** Разведка обычных документов: что можно переносить, что требует санитизации. */
function cmdScanDocs(rootAbs) {
  // Корнем может быть и одиночный файл: проверять один документ — обычный случай.
  const all = fs.statSync(rootAbs).isFile() ? [rootAbs] : walkFiles(rootAbs)
  const files = all.filter((f) => f.endsWith('.md') || f.endsWith('.sh') || f.endsWith('.mjs') || f.endsWith('.js') || f.endsWith('.py'))
  console.log(`${C.b}Разведка документов:${C.x} ${rootAbs.replace(os.homedir(), '~')}`)
  console.log(`файлов: ${files.length}\n`)

  const rows = []
  for (const f of files) {
    let text = ''
    try { text = fs.readFileSync(f, 'utf8') } catch { continue }
    const r = scanText(text)
    const abs = /\/Users\/[A-Za-z0-9._-]+\//.test(text) || /\/home\/[A-Za-z0-9._-]+\//.test(text)
    const verdict = r.suspected.length ? 'ОТКАЗ' : (r.personal.length || abs) ? 'санитизация' : r.placeholder.length ? 'примеры-ключей' : 'чисто'
    rows.push({ f, verdict, why: r.suspected.join(', ') || r.personal.join(', ') || (abs ? 'абсолютный путь' : '') || r.placeholder.join(', ') })
  }

  const order = { 'ОТКАЗ': 0, 'санитизация': 1, 'примеры-ключей': 2, 'чисто': 3 }
  rows.sort((a, b) => order[a.verdict] - order[b.verdict] || a.f.localeCompare(b.f))
  const counts = {}
  for (const r of rows) counts[r.verdict] = (counts[r.verdict] || 0) + 1
  console.log(Object.entries(counts).map(([k, v]) => `${k}: ${v}`).join(' · ') + '\n')

  for (const r of rows) {
    if (r.verdict === 'чисто') continue
    const color = r.verdict === 'ОТКАЗ' ? C.r : r.verdict === 'санитизация' ? C.y : C.d
    console.log(`  ${color}${r.verdict}${C.x} ${r.f.replace(rootAbs, '.').replace(os.homedir(), '~')}`)
    if (r.why) console.log(`         ${C.d}${r.why}${C.x}`)
  }
  const clean = rows.filter((r) => r.verdict === 'чисто')
  console.log(`\n${C.g}чистых файлов: ${clean.length}${C.x} — их можно переносить как есть`)
  console.log(`${C.d}значения секретов не читались и не печатались${C.x}`)
}

function cmdImport(man, src, dryRun) {
  if (!src) die('укажите путь к скиллу: harness import <путь> [--dry-run]')
  const srcAbs = tilde(src)
  if (!fs.existsSync(srcAbs)) die(`нет такого пути: ${srcAbs}`)
  const info = inspectSkillDir(srcAbs)

  console.log(`${C.b}Импорт:${C.x} ${srcAbs.replace(os.homedir(), '~')}`)
  if (info.error) die(`скилл не годен: ${info.error}`)
  console.log(`  имя:     ${info.name}`)
  console.log(`  статус:  ${info.status}${info.status === 'candidate' ? ' (нет EVIDENCE.md — попадёт как кандидат)' : ''}`)
  console.log(`  файлов:  ${info.files}, ${(info.bytes / 1024).toFixed(0)} КБ`)

  if (info.suspected.length) {
    console.log(`\n${C.r}ОТКАЗ.${C.x} Похоже на настоящие секреты: ${info.suspected.join(', ')}`)
    console.log('Перенос в публичный репозиторий необратим — импорт остановлен.')
    console.log(`${C.d}Ключ, попавший в файл, сначала отзывается, потом переносится содержимое.${C.x}`)
    process.exit(2)
  }
  if (info.placeholder.length) {
    console.log(`\n${C.d}Примеры-заглушки ключей (${info.placeholder.join(', ')}) — переносить можно, но лучше заменить на многоточие: сканеры секретов на них срабатывают.${C.x}`)
  }
  if (info.personal.length) {
    console.log(`\n${C.y}Требуется санитизация:${C.x} ${info.personal.join(', ')}`)
    console.log(`${C.d}Абсолютные пути будут заменены на ~. Остальные находки требуют внимания вручную.${C.x}`)
  }

  const dest = path.join(REPO, man.core_skills || 'core/skills', info.name)
  if (fs.existsSync(dest)) {
    console.log(`\n${C.y}Уже есть в ядре:${C.x} ${dest.replace(REPO, '.')} — импорт не перезаписывает.`)
    console.log(`${C.d}Сравните вручную или удалите существующий каталог осознанно.${C.x}`)
    process.exit(3)
  }

  if (dryRun) {
    console.log(`\n${C.b}--dry-run${C.x}: было бы скопировано в ${dest.replace(REPO, '.')}`)
    return
  }

  fs.mkdirSync(dest, { recursive: true })
  let sanitized = 0
  for (const f of walkFiles(srcAbs)) {
    const rel = path.relative(srcAbs, f)
    const target = path.join(dest, rel)
    fs.mkdirSync(path.dirname(target), { recursive: true })
    let text = null
    try { text = fs.readFileSync(f, 'utf8') } catch { /* бинарный ресурс — копируем как есть */ }
    if (text !== null) {
      const clean = sanitizeText(text)
      if (clean !== text) sanitized++
      fs.writeFileSync(target, clean)
    } else {
      fs.copyFileSync(f, target)
    }
  }
  console.log(`\n${C.g}Перенесено${C.x} в ${dest.replace(REPO, '.')}${sanitized ? `, файлов с обезличенными путями: ${sanitized}` : ''}`)
  console.log(`${C.d}статус «кандидат»: без EVIDENCE.md скилл не устанавливается по умолчанию${C.x}`)
  console.log(`${C.d}проверить: harness doctor${C.x}`)
}


/**
 * Создать заготовку скилла из шаблона.
 *
 * Смысл: порог доказательности не должен быть бюрократией. Заготовка сразу
 * содержит и SKILL.md, и EVIDENCE.md с полями замера — заполнить проще,
