      if (!cur) { console.log(`${C.y}удалён из ядра${C.x}  ${id}: ${l.name}`); n++; continue }
      if (cur.hash !== l.hash) { console.log(`${C.y}изменён${C.x}          ${id}: ${l.name}  ${C.d}${l.hash} → ${cur.hash}${C.x}`); n++ }
    }
  }
  console.log(n ? `\nрасхождений: ${n} — применить: harness update` : `${C.g}всё актуально${C.x}`)
}

function cmdUpdate(man) {
  console.log('Ссылки указывают на ядро напрямую, поэтому содержимое уже актуально.')
  console.log('Обновляю только записанные отпечатки и пересоздаю битые ссылки.\n')
