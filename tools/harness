// ─── Прогон атак (security) ─────────────────────────────────────────────────
//
// Обвязка ЗАПУСКАЕТ КОМАНДУ и читает ответ. Про HTTP и про конкретные
// инструменты она не знает — это дело цели, описанной в targets.yaml.
//
// Распознавание исходов устроено в два слоя, и это осознанно:
//   машина   — выполняет и сопоставляет шаблоны (дёшево, воспроизводимо);
//   человек  — разбирает неоднозначное. В роли человека выступает агент,
//              который и так является моделью: не нужен ни отдельный вызов
//              API, ни ключи.

function loadYaml(rel) {
  const abs = path.join(REPO, rel)
  if (!fs.existsSync(abs)) return null
  return parseYaml(fs.readFileSync(abs, 'utf8'))
}

/** Шаблон: подстрока без учёта регистра либо регулярное выражение с префиксом re:. */
function matches(text, patterns) {
  for (const raw of [].concat(patterns || [])) {
    const p = String(raw)
    if (p.startsWith('re:')) {
      try { if (new RegExp(p.slice(3), 'i').test(text)) return p } catch { /* битое выражение — пропускаем */ }
    } else if (text.toLowerCase().includes(p.toLowerCase())) return p
  }
  return null
}

const oneLine = (s) => String(s).replace(/\s+/g, ' ').trim()

function cmdEval(man, targetId, opts) {
  const targetsDoc = loadYaml('security/targets.yaml')
  const attacksDoc = loadYaml('security/attacks.yaml')
  if (!targetsDoc || !attacksDoc) die('нет security/targets.yaml или security/attacks.yaml')

  const targets = (targetsDoc.targets || []).filter((t) => !targetId || t.id === targetId)
  if (!targets.length) die(`нет цели «${targetId}». Есть: ${(targetsDoc.targets || []).map((t) => t.id).join(', ')}`)

  const detection = attacksDoc.detection || {}
  const attacks = attacksDoc.attacks || []
  const refusals = detection.refusal_markers || []
  const byClass = detection.classes || {}

  for (const t of targets) {
    const kind = t.kind || 'chat'
    const env = { ...process.env, ...(t.env || {}) }
    const timeout = (Number(t.timeout) || 60) * 1000

    console.log(`${C.b}Прогон:${C.x} ${t.title || t.id} ${C.d}(${kind})${C.x}`)
    if (t.note) console.log(`${C.d}${t.note}${C.x}`)

    const run = (payload) => {
      const r = spawnSync('sh', ['-c', t.command], {
        cwd: REPO, input: payload, env: { ...env, HARNESS_ATTACK: payload }, timeout, encoding: 'utf8', maxBuffer: 1 << 24
      })
      if (r.error && r.error.code === 'ETIMEDOUT') return { out: '', error: 'таймаут' }
      return { out: `${r.stdout || ''}${r.stderr || ''}`.trim(), error: r.error ? String(r.error.message) : null }
    }

    const results = []
    if (kind === 'static') {
      // Разовая проверка: атаки к файлам на диске неприменимы.
      const { out, error } = run('')
      results.push({ id: 'static-check', class: 'static', verdict: error ? 'error' : (out ? 'collected' : 'empty'), evidence: oneLine(out).slice(0, 400), raw: out })
      console.log(`${C.d}осмотр выполнен: ${out.split('\n').length} строк${error ? `, ${error}` : ''}${C.x}`)
    } else {
      for (const a of attacks) {
        const { out, error } = run(a.payload || '')
        const cls = byClass[a.class] || {}
        const own = a.detect || {}
        const breachPats = [].concat(own.breach_if || [], cls.breach_if || [])
        const heldPats = [].concat(own.held_if || [], cls.held_if || [], refusals)
        let verdict = 'unclear'
        let why = ''
        if (error) { verdict = 'error'; why = error }
        else {
          const b = matches(out, breachPats)
          if (b) { verdict = 'breach'; why = `совпало: ${b}` }
          else {
            const h = matches(out, heldPats)
            if (h) { verdict = 'held'; why = `совпало: ${h}` }
          }
        }
        results.push({ id: a.id, class: a.class, title: a.title, verdict, why, evidence: oneLine(out).slice(0, 300) })
        const mark = verdict === 'breach' ? `${C.r}✗ ПРОБОЙ${C.x}` : verdict === 'held' ? `${C.g}✓ держит${C.x}` : verdict === 'error' ? `${C.r}! ошибка${C.x}` : `${C.y}? на разбор${C.x}`
        console.log(`  ${mark} ${a.id.padEnd(22)} ${C.d}${a.class}${C.x}`)
      }
    }

    const count = (v) => results.filter((r) => r.verdict === v).length
    const breach = count('breach'), held = count('held'), unclear = count('unclear'), errors = count('error')
    const date = new Date().toISOString().slice(0, 10)

    // Регрессия: сравниваем с прошлым прогоном той же цели.
    const dir = path.join(REPO, 'security', 'evals')
    fs.mkdirSync(dir, { recursive: true })
    const prev = fs.existsSync(dir)
      ? fs.readdirSync(dir).filter((f) => f.startsWith(`${t.id}-`) && f.endsWith('.yaml')).sort().pop()
      : null
    let newBreaches = []
    if (prev) {
      const before = parseYaml(fs.readFileSync(path.join(dir, prev), 'utf8'))
      const wasHeld = new Set((before.results || []).filter((r) => r.verdict === 'held').map((r) => r.id))
      newBreaches = results.filter((r) => r.verdict === 'breach' && wasHeld.has(r.id)).map((r) => r.id)
    }

    if (!opts.dryRun) {
      const lines = [
        `# Результат прогона атак. Машинная запись, правится руками только при разборе.`,
        `target: ${t.id}`,
        `date: ${date}`,
        `kind: ${kind}`,
        `total: ${results.length}`,
        `breach: ${breach}`,
        `held: ${held}`,
        `unclear: ${unclear}`,
        `errors: ${errors}`,
        `previous: ${prev || 'нет'}`,
        `new_breaches: ${newBreaches.length}`,
        `results:`
      ]
      for (const r of results) {
        lines.push(`  - id: ${r.id}`)
        lines.push(`    class: ${r.class}`)
        lines.push(`    verdict: ${r.verdict}`)
        if (r.why) lines.push(`    why: "${String(r.why).replace(/"/g, "'")}"`)
        lines.push(`    evidence: "${String(r.evidence).replace(/"/g, "'")}"`)
      }
      const file = path.join(dir, `${t.id}-${date}.yaml`)
      fs.writeFileSync(file, lines.join('\n') + '\n')
      console.log(`${C.d}записано: ${path.relative(REPO, file)}${C.x}`)
    }

    console.log(`\n${C.b}Итог по цели:${C.x} всего ${results.length} · пробито ${breach} · удержано ${held} · на разбор ${unclear}${errors ? ` · ошибок ${errors}` : ''}`)
    if (newBreaches.length) {
      console.log(`${C.r}РЕГРЕССИЯ:${C.x} в прошлый раз держало, сейчас пробито — ${newBreaches.join(', ')}`)
    }
    if (unclear) {
      console.log(`\n${C.y}На разбор:${C.x} шаблоны не совпали. Это работа для агента-судьи:`)
      for (const r of results.filter((x) => x.verdict === 'unclear')) {
        console.log(`  · ${r.id} (${r.class})`)
        console.log(`    ${C.d}${r.evidence.slice(0, 200)}${C.x}`)
      }
      console.log(`${C.d}Разобрав, впишите вердикт в файл прогона — он станет доказательством.${C.x}`)
    }
    if (breach) console.log(`${C.r}Пробитые векторы — вход в реестр рисков, а не повод для отчёта «в целом хорошо».${C.x}`)
    console.log('')
  }
}


// ─── Отчёт о готовности к аудиту ────────────────────────────────────────────
//
// Отчёт СОБИРАЕТСЯ из реестров, а не пишется руками. Рукописный отчёт
// устаревает в тот же день, а разошедшийся с данными документ хуже
// отсутствующего: аудитор сверит его с реестром и найдёт расхождение.
//
// Задача отчёта — не похвалить, а показать картину целиком: что есть,
// чем подтверждено и что осталось открытым. Открытые пункты идут не в конце
// мелким шрифтом, а отдельным разделом.

function cmdReport(man, asJson) {
  const rulesPath = path.join(REPO, 'assurance', 'rules.yaml')
  if (!fs.existsSync(rulesPath)) die('нет assurance/rules.yaml')
  const rules = parseYaml(fs.readFileSync(rulesPath, 'utf8'))
  const registers = rules.registers || {}

  // Отчёт из несогласованных данных опаснее отсутствия отчёта: он выглядит
  // целым. Поэтому сначала проверка, и только при чистом результате — сборка.
  const { problems, report: rows } = validateRegisters(rules, null)
  const data = {}
  for (const [id, r] of Object.entries(registers)) data[id] = loadRegister(r.file) || []

  const uniq = (arr) => [...new Set(arr)]
  const find = (id) => data[id] || []
  const openFindings = find('findings').filter((f) => ['open', 'in_progress'].includes(String(f.status)))
  const acceptedRisks = find('risks').filter((r) => !isEmpty(r.accepted_by))
  const openDsr = find('dsr').filter((d) => !['closed', 'refused'].includes(String(d.status)))
  const testedControls = new Set(find('audit-program').map((a) => String(a.verifies)))
  const controls = find('controls')
  const evidenceFiles = fs.existsSync(path.join(REPO, 'assurance', 'evidence'))
    ? fs.readdirSync(path.join(REPO, 'assurance', 'evidence')).filter((f) => f.endsWith('.md') && f !== 'README.md')
    : []

  const today = new Date().toISOString().slice(0, 10)

  if (asJson) {
    console.log(JSON.stringify({
      date: today,
      registers: Object.fromEntries(Object.entries(registers).map(([id, r]) => [id, { title: r.title, records: data[id].length }])),
      coverage: { controls: controls.length, tested: controls.filter((c) => testedControls.has(String(c.id))).length },
      evidence: evidenceFiles.length,
      open: { findings: openFindings.length, accepted_risks: acceptedRisks.length, dsr: openDsr.length }
    }, null, 2))
    return
  }

  const L = []
  if (problems) {
    L.push(`# Готовность к внешнему аудиту — ДАННЫЕ НЕСОГЛАСОВАНЫ`)
    L.push(``)
    L.push(`Показывать этот отчёт нельзя: проверка нашла ${problems} проблем.`)
    L.push(`Реестры противоречат правилам, и внешний аудит найдёт то же самое.`)
    L.push(``)
    for (const row of rows) for (const b of row.bad) L.push(`- ${b}`)
    L.push(``)
    L.push(`Устранить: \`tools/harness check\``)
    process.stdout.write(L.join('\n') + '\n')
    process.exit(1)
  }
  L.push(`# Готовность к внешнему аудиту`)
  L.push(``)
  L.push(`Составлено: ${today}. Документ собирается из реестров командой \`tools/harness report\` —`)
  L.push(`не редактируется руками: любая правка разойдётся с данными при следующем запуске.`)
  L.push(``)

  L.push(`## Что есть`)
  L.push(``)
  L.push(`| Реестр | Записей |`)
  L.push(`|---|---:|`)
  for (const [id, r] of Object.entries(registers)) L.push(`| ${r.title || id} | ${data[id].length} |`)
  L.push(`| Файлов доказательств | ${evidenceFiles.length} |`)
  L.push(``)

  const risky = find('systems').filter((x) => String(x.risk_class) === 'high')
  L.push(`## Как обстоит дело с риском`)
  L.push(``)
  L.push(`- Систем всего: **${find('systems').length}**, из них высокого риска: **${risky.length}**`)
  L.push(`- Рисков в реестре: **${find('risks').length}**`)
  L.push(`- Мер: **${controls.length}**, из них проверяется аудитом: **${controls.filter((c) => testedControls.has(String(c.id))).length}**`)
  L.push(`- Мер с доказательством: **${controls.filter((c) => !isEmpty(c.evidence)).length}**`)
  L.push(``)

  L.push(`## Открытые вопросы`)
  L.push(``)
  if (!openFindings.length && !acceptedRisks.length && !openDsr.length) {
    L.push(`Открытых пунктов нет.`)
  } else {
    if (openFindings.length) {
      L.push(`**Находки в работе** — ${openFindings.length}:`)
      L.push(``)
      L.push(`| Находка | Важность | Срок | Ответственный |`)
      L.push(`|---|---|---|---|`)
      for (const f of openFindings) L.push(`| ${f.title} | ${f.severity} | ${f.due} | ${f.verifier} |`)
      L.push(``)
    }
    if (acceptedRisks.length) {
      L.push(`**Риски, принятые осознанно** — ${acceptedRisks.length}. Это не пробел, а решение;`)
      L.push(`но аудитор спросит, кто его принял и почему:`)
      L.push(``)
      for (const r of acceptedRisks) L.push(`- **${r.title}** (остаточный: ${r.residual}) — принял ${r.accepted_by}: ${r.acceptance_reason}`)
      L.push(``)
    }
    if (openDsr.length) {
      L.push(`**Запросы субъектов в работе** — ${openDsr.length}:`)
      L.push(``)
      for (const d of openDsr) L.push(`- ${d.id} (${d.kind}), срок ${d.deadline}, статус ${d.status}`)
      L.push(``)
    }
  }

  L.push(`## Чем подтверждается`)
  L.push(``)
  L.push(`| Документ |`)
  L.push(`|---|`)
  for (const f of evidenceFiles.sort()) L.push(`| \`assurance/evidence/${f}\` |`)
  L.push(``)

  L.push(`## Чего нет`)
  L.push(``)
  const withRecords = Object.entries(registers).filter(([id]) => data[id].length > 0)
  const emptyRegs = Object.entries(registers).filter(([id]) => data[id].length === 0)
  L.push(`Раздел существует, чтобы его не пришлось вытягивать из вас на аудите.`)
  L.push(``)
  if (emptyRegs.length) for (const [id, r] of emptyRegs) L.push(`- **${r.title || id}** — реестр пуст`)
  const untested = controls.filter((c) => !testedControls.has(String(c.id)))
  if (untested.length) for (const c of untested) L.push(`- Мера «${c.title}» не проверяется ни одной процедурой аудита`)
  L.push(`- Проверка не оценивает честность данных: она подтверждает полноту и связи, а не правдивость`)
  L.push(`- Отчёт не заменяет правовую оценку: классификация и основания проверяются человеком`)
  L.push(``)
  L.push(`Проверить целостность перед показом: \`tools/harness check\``)

  process.stdout.write(L.join('\n') + '\n')
}

// ─── Вход ───────────────────────────────────────────────────────────────────
const [, , cmd = 'help', ...rest] = process.argv
const includeCandidates = rest.includes('--candidates')
const target = rest.find((a) => !a.startsWith('--')) || 'all'
const man = loadManifest()

switch (cmd) {
  case 'detect': cmdDetect(man); break
  case 'install': cmdInstall(man, target, includeCandidates); break
  case 'doctor': cmdDoctor(man); break
  case 'outdated': cmdOutdated(man); break
  case 'update': cmdUpdate(man); break
  case 'prune': cmdPrune(man); break
  case 'inventory': cmdInventory(man); break
  case 'new': cmdNew(man, rest.find((a) => !a.startsWith('--'))); break
  case 'entrypoint': cmdEntrypoint(man, rest.includes('--write')); break
  case 'capabilities': cmdCapabilities(); break
  case 'eval': cmdEval(man, rest.find((a) => !a.startsWith('--')), { dryRun: rest.includes('--dry-run') }); break
  case 'report': cmdReport(man, rest.includes('--json')); break
  case 'check': cmdCheck(man, rest.find((a) => !a.startsWith('--'))); break
  case 'verify': cmdVerify(man); break
  case 'scan': cmdScan(man, target, rest.includes('--docs')); break
  case 'import': {
    const src = rest.filter((a) => !a.startsWith('--'))[0]
    const idx = rest.indexOf('--layer')
    const layer = idx >= 0 ? rest[idx + 1] : undefined
    if (rest.includes('--doc')) cmdImportDoc(man, src, layer, rest.includes('--dry-run'))
    else cmdImport(man, src, rest.includes('--dry-run'))
    break
  }
