  console.log(`${C.d}проверить: harness verify && harness doctor${C.x}`)
}


/**
 * Точка входа обвязки: короткий файл инструкций, который ведёт к остальному.
 *
 * Зачем: скиллы инструмент подхватывает сам, а правила поведения — нет. Без
 * точки входа ядро лежит в репозитории мёртвым грузом: агент о нём не знает.
 *
 * Почему короткий: файл инструкций читается в КАЖДОЙ сессии и имеет бюджет
 * (у DeepSeek Harness — 64 КБ, при превышении широкие файлы отбрасываются).
 * Поэтому здесь только указатель: имя, назначение и куда идти за глубиной.
 */

/** Реестр возможностей обвязки — маршрутизатор. */
function loadCapabilities() {
  const file = path.join(REPO, 'capabilities.yaml')
  if (!fs.existsSync(file)) return []
  const data = parseYaml(fs.readFileSync(file, 'utf8'))
  return Array.isArray(data.capabilities) ? data.capabilities : []
}

function buildEntrypoint(man) {
  const coreDir = path.join(REPO, 'core')
  const readDir = (rel) => {
    const dir = path.join(coreDir, rel)
    if (!fs.existsSync(dir)) return []
    const out = []
    const walk = (d) => {
      for (const e of fs.readdirSync(d, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
        const full = path.join(d, e.name)
        if (e.isDirectory()) { walk(full); continue }
        if (!e.name.endsWith('.md') || e.name === 'README.md') continue
        const m = fs.readFileSync(full, 'utf8').match(/^---\r?\n([\s\S]*?)\r?\n---/)
        let name = path.basename(e.name, '.md')
        let desc = ''
        if (m) {
          try {
            const meta = parseYaml(m[1])
            if (meta.name) name = meta.name
            if (meta.description) desc = String(meta.description)
          } catch { /* описание необязательно для указателя */ }
        }
        out.push({ name, desc: desc.replace(/\s+/g, ' ').trim(), rel: path.relative(REPO, full) })
      }
    }
    walk(dir)
    return out
  }

  const policies = readDir('policies')
  const playbooks = readDir('playbooks')
  const knowledge = readDir('knowledge')

  const line = (x) => `- \`${x.name}\`${x.desc ? ` — ${x.desc.split('. ')[0].replace(/\.$/, '')}` : ''}`

  // Маршрут возможностей. Берём только то, что предназначено агенту: список
  // команд для человека в файле инструкций только занимает бюджет.
  const caps = loadCapabilities().filter((c) => !c.audience || c.audience === 'agent')
  const route = caps.map((c) => {
    const when = [].concat(c.when || [])[0] || c.purpose || ''
    return `| ${when} | \`${c.invoke}\` |`
  }).join('\n')

  return `# Обвязка агента

Ядро обвязки: \`${(() => {
    const home = os.homedir()
    // Относительный путь имеет смысл только внутри дома; иначе показываем
    // абсолютный — «../../../private/tmp/...» агенту ничего не говорит.
    if (REPO.startsWith(home + path.sep)) return '~/' + path.relative(home, REPO)
    return REPO
  })()}\`.
Правила, процедуры и знание читаются **по требованию**, а не загружаются целиком:
у файла инструкций есть бюджет, и глубина в нём не помещается.

## Правила — открывать по теме задачи

${policies.map(line).join('\n')}

## Процедуры и знание

${playbooks.length ? playbooks.map(line).join('\n') : '- (пока пусто)'}
${knowledge.length ? knowledge.map(line).join('\n') : ''}

Скиллы (\`core/skills/\`) инструмент подхватывает сам — их описания видны заранее.

## Что умеет обвязка

Возможность без условия применения равносильна её отсутствию. Поэтому —
не список команд, а маршрут: слева признак задачи, справа что запустить.

| Когда | Что запустить |
|---|---|
${route}

Полный маршрут с оговорками «не когда» — \`capabilities.yaml\`.
Слои ядра: \`core/README.md\`. Реестры: \`assurance/README.md\`.
`
}

function cmdEntrypoint(man, write) {
  const text = buildEntrypoint(man)
  if (!write) { process.stdout.write(text); return }

  let placed = 0, skipped = 0
  for (const [id, t] of Object.entries(man.tools || {})) {
    const found = hasCommand(t.detect_cmd) || [].concat(t.detect_dirs || []).map(tilde).some((d) => fs.existsSync(d))
    if (!found) continue
    for (const f of [].concat(t.instruction_files || [])) {
      if (!f) continue
      const abs = tilde(f)
      if (fs.existsSync(abs)) {
        // Чужой файл инструкций не перезаписывается никогда: он может содержать
        // годы правил владельца. Показываем, что не тронули, и где наш вариант.
        console.log(`  ${C.y}!${C.x} ${id}: ${f} уже существует — не трогаю`)
        skipped++
        continue
      }
      fs.mkdirSync(path.dirname(abs), { recursive: true })
      fs.writeFileSync(abs, text)
      console.log(`  ${C.g}✓${C.x} ${id}: точка входа записана в ${f} (${(text.length / 1024).toFixed(1)} КБ)`)
      placed++
    }
  }
  console.log(`\nзаписано: ${placed}, пропущено (файл занят): ${skipped}`)
  if (skipped) console.log(`${C.d}Свой файл инструкций важнее нашего: слияние — решение владельца.${C.x}`)
}


// ─── Проверка реестров (assurance) ──────────────────────────────────────────
//
// Правила лежат в assurance/rules.yaml, а не здесь. Код только исполняет
// пять конструкций и умеет ровно одно: сказать, чего не хватает. Новая
// предметная область добавляется файлом правил.

function loadRegister(file) {
  const abs = path.join(REPO, file)
  if (!fs.existsSync(abs)) return null
  const data = parseYaml(fs.readFileSync(abs, 'utf8'))
  for (const v of Object.values(data)) if (Array.isArray(v)) return v
  return []
}

const isEmpty = (v) => v === undefined || v === null || v === '' || (Array.isArray(v) && !v.length)
const today = () => new Date().toISOString().slice(0, 10)

/**
 * Проверить реестры по правилам. Возвращает находки, ничего не печатает.
 *
 * Вынесено отдельно, потому что проверять нужно в двух местах: при явном
 * запуске и перед сборкой отчёта. Отчёт, собранный из несогласованных данных,
 * выглядит целым и именно поэтому опасен: аудитор сверит его с реестром
 * и найдёт расхождение.
 */
function validateRegisters(rules, only) {
  const registers = rules.registers || {}
  const data = {}, ids = {}
  for (const [id, r] of Object.entries(registers)) {
    data[id] = loadRegister(r.file)
    ids[id] = new Set((data[id] || []).map((e) => String(e.id)))
  }

  const report = []
  let problems = 0, checked = 0

  for (const [id, r] of Object.entries(registers)) {
    if (only && only !== id) continue
    const rows = data[id]
    if (rows === null) { report.push({ id, title: r.title || id, rows: 0, bad: [`нет файла ${r.file}`] }); problems++; continue }
    const bad = []
    // Одно и то же отсутствующее поле может поймать и require, и специализированная
    // проверка (например, evidence). Сообщение должно быть одно: повтор читается
    // как две разные проблемы и завышает серьёзность.
    const missing = new Set()
    const miss = (where, field, msg) => { const k = `${where}|${field}`; if (missing.has(k)) return; missing.add(k); bad.push(msg) }
    for (const row of rows) {
      checked++
      const where = `${id}/${row.id || '?'}`
      for (const f of [].concat(r.require || [])) {
        if (isEmpty(row[f])) miss(where, f, `${where}: не заполнено обязательное поле «${f}»`)
      }
      for (const chk of [].concat(r.checks || [])) {
        if (chk.kind === 'require_if') {
          const v = String(row[chk.field] ?? '')
          // Условие: одно значение (equals) либо набор (in). Набор нужен там,
          // где правило одинаково для нескольких уровней — например, «любой
          // риск выше аппетита требует явного принятия».
          const values = chk.in ? [].concat(chk.in).map(String)
            : chk.equals !== undefined ? [String(chk.equals)] : []
          if (values.includes(v)) {
            for (const f of [].concat(chk.require || [])) {
              if (isEmpty(row[f])) miss(where, f, `${where}: при ${chk.field}=${v} обязательно «${f}»`)
            }
          }
        } else if (chk.kind === 'one_of') {
          const v = String(row[chk.field] ?? '')
          if (!isEmpty(row[chk.field]) && !chk.values.map(String).includes(v)) {
            bad.push(`${where}: «${chk.field}» = «${v}», допустимо: ${chk.values.join(', ')}`)
          }
        } else if (chk.kind === 'ref' || chk.kind === 'ref_any') {
          const v = row[chk.field]
          if (!isEmpty(v)) {
            const target = String(v)
            // ref_any: ссылка допустима в любой из перечисленных реестров —
            // проверка аудита может подтверждать и меру, и ответ.
            const list = chk.kind === 'ref_any' ? [].concat(chk.registers || []) : [chk.register]
            const known = list.filter((r) => ids[r])
            if (!known.length) bad.push(`${where}: ссылка на неизвестный реестр «${list.join(', ')}»`)
            else if (!known.some((r) => ids[r].has(target))) {
              bad.push(`${where}: «${chk.field}» ссылается на несуществующее «${target}» (искали в: ${known.join(', ')})`)
            }
          }
        } else if (chk.kind === 'matrix') {
          // Уровень риска выводится из двух осей по таблице, а остаточный
          // уровень не может быть ВЫШЕ исходного: обработка не ухудшает
          // положение. Правило ловит случай, когда в реестре записан
          // остаточный риск выше исходного — то есть обработка не описана
          // или описана неверно.
          const doc = loadYaml(chk.table)
          const table = doc && doc[chk.key || 'matrix']
          const axes = [].concat(chk.from || [])
          const level = table && table[String(row[axes[0]])] && table[String(row[axes[0]])][String(row[axes[1]])]
          if (!table) {
            bad.push(`${where}: нет таблицы ${chk.table} — сверка не выполнена`)
          } else if (!level) {
            // Пустая клетка означала бы, что проверка молча пропущена.
            bad.push(`${where}: в матрице нет уровня для ${axes[0]}=${row[axes[0]]} и ${axes[1]}=${row[axes[1]]}`)
          } else {
            const order = [].concat(chk.order || ['low', 'medium', 'high']).map(String)
            const got = order.indexOf(String(row[chk.field]))
            const base = order.indexOf(String(level))
            if (got >= 0 && base >= 0 && got > base) {
              bad.push(`${where}: «${chk.field}» = ${row[chk.field]} выше исходного уровня ${level} (${axes[0]}=${row[axes[0]]}, ${axes[1]}=${row[axes[1]]}) — обработка не может ухудшить риск`)
            }
          }
        } else if (chk.kind === 'ref_each') {
          // Ссылка-список: каждая запись должна существовать. Нужна там, где
          // одна политика закрывает несколько рисков, и потеря одной ссылки
          // не должна проходить незамеченной.
          const list = [].concat(row[chk.field] === undefined ? [] : row[chk.field])
          for (const v of list) {
            if (isEmpty(v)) continue
            const target = String(v)
            if (!ids[chk.register]) bad.push(`${where}: ссылка на неизвестный реестр «${chk.register}»`)
            else if (!ids[chk.register].has(target)) bad.push(`${where}: «${chk.field}» ссылается на несуществующее «${target}»`)
          }
        } else if (chk.kind === 'covered_by') {
          // Покрытие: запись обязана кем-то проверяться. Мера, которую не
          // проверяет ни одна процедура аудита, существует только на бумаге —
          // и это опаснее отсутствующей меры, потому что о ней думают,
          // что она есть.
          const covering = data[chk.register] || []
          const seen = covering.some((r) => String(r[chk.field]) === String(row.id))
          // Текст находки задаётся правилом: «не проверяется аудитом» для меры
          // и «ничем не реализована» для политики — разные вещи, и общая
          // формулировка вводила бы в заблуждение.
          if (!seen) {
            const why = chk.reason || `нет ссылки в ${chk.register}.${chk.field}`
            bad.push(`${where}: ${why}`)
          }
        } else if (chk.kind === 'evidence') {
          // Поле обязательно: «да, мы это делаем» без ссылки на доказательство —
          // обещание, а не ответ. Пропуск пустого поля здесь был дырой:
          // хватало удалить строку с доказательством, и проверка молчала.
          for (const f of [].concat(chk.field)) {
            const v = row[f]
            if (isEmpty(v)) { miss(where, f, `${where}: не указано доказательство в поле «${f}»`); continue }
            if (!fs.existsSync(path.join(REPO, String(v)))) bad.push(`${where}: доказательство не найдено — ${v}`)
          }
        } else if (chk.kind === 'not_past') {
          const v = row[chk.field]
          // Срок перестаёт иметь значение, когда вопрос закрыт: просроченный
          // запрос субъекта, отвеченный в срок и закрытый, — не нарушение.
          // unless_in выражает это без отдельного вида правила.
          const skip = chk.unless_in && [].concat(chk.unless_in).map(String).includes(String(row[chk.other_field || 'status'] ?? ''))
          if (!skip && !isEmpty(v) && String(v) < today()) bad.push(`${where}: «${chk.field}» = ${v} — срок прошёл`)
        } else {
          bad.push(`${where}: неизвестная конструкция правила «${chk.kind}»`)
        }
      }
    }
    report.push({ id, title: r.title || id, rows: rows.length, bad })
    problems += bad.length
  }

  return { report, problems, checked, data, registers }
}

function cmdCheck(man, only) {
